        <xsd:sequence>
          <xsd:element name="indexName" type="IndexName">
            <xsd:annotation>
              <xsd:documentation>The name of the index expressed as a free format string. FpML does not define usage rules for this element.</xsd:documentation>
            </xsd:annotation>
          </xsd:element>
          <xsd:element name="indexId" type="IndexId" minOccurs="0" maxOccurs="unbounded">
