      </xsd:extension>
    </xsd:simpleContent>
  </xsd:complexType>
  <xsd:complexType name="IndexName">
    <xsd:annotation>
      <xsd:documentation fpml-annotation:aiGenerated="true">The official name of a financial index referenced in a transaction. It extends the NonEmptyScheme base type and includes an indexNameScheme attribute, which provides a URI defining the naming convention. This ensures consistency and accuracy when identifying indices across financial agreements.</xsd:documentation>
