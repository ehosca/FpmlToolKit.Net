<Project>

  <!--
    One NuGet package per FpML version (packages/FpmlToolKit.Fpml<version>/*.csproj, generated by
    scripts/add-schema-version.cs). A package project compiles nothing itself: it references the version's view
    projects (fpml-<version>-<view>) and packs their assemblies into lib/<tfm>/ and their schemas into
    xsd/<view project>/. Import this file before the ProjectReference items.
  -->

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <EnableDefaultItems>false</EnableDefaultItems>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);FpmlPackViewAssemblies</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <!-- The view assemblies ship inside this package, so they must not become package dependencies. -->
  <ItemDefinitionGroup>
    <ProjectReference>
      <PrivateAssets>all</PrivateAssets>
    </ProjectReference>
  </ItemDefinitionGroup>

  <ItemGroup>
    <PackageReference Include="XObjectsCore" Version="$(XObjectsCoreVersion)" />
    <None Include="$(MSBuildThisFileDirectory)../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!-- GetTargetPath only reports each view's output path, so this also works when packing with the no-build option. -->
  <Target Name="FpmlPackViewAssemblies">
    <MSBuild Projects="@(ProjectReference)" Targets="GetTargetPath" Properties="TargetFramework=$(TargetFramework);Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_FpmlViewAssembly" />
    </MSBuild>
    <ItemGroup>
      <!-- Assemblies only: the generated source is not shipped, so the (large) .pdb files would add little. -->
      <TfmSpecificPackageFile Include="@(_FpmlViewAssembly)" PackagePath="lib/$(TargetFramework)/" />
    </ItemGroup>
    <Error Condition="!Exists('%(_FpmlViewAssembly.FullPath)')" Text="View assembly %(_FpmlViewAssembly.FullPath) is missing; build before packing." />
  </Target>

</Project>
