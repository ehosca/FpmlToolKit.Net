<xsd:schema xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" xmlns="http://www.fpml.org/FpML-5/pretrade" xmlns:dsig="http://www.w3.org/2000/09/xmldsig#" xmlns:fpml-annotation="http://www.fpml.org/annotation" xmlns:xsd="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.fpml.org/FpML-5/pretrade" ecore:documentRoot="FpML" ecore:nsPrefix="pre" ecore:package="org.fpml.pretrade" version="$Revision$" xml:lang="en" elementFormDefault="qualified" attributeFormDefault="unqualified">
  <xsd:include schemaLocation="fpml-msg-5-14.xsd" />
  <xsd:complexType name="ComponentProduct">
    <xsd:annotation>
      <xsd:documentation>Definition of an underlying product which is part of a package. A full product definition of the component may be provided elsewhere within the document, in this case the product definition should be referred to by specifying productDefinitionsReference. In the case when the component is not defined within the product definitions document, product id should be provided.</xsd:documentation>
    </xsd:annotation>
    <xsd:sequence>
      <xsd:choice minOccurs="0">
        <xsd:element name="productId" type="ProductId">
          <xsd:annotation>
            <xsd:documentation fpml-annotation:aiGenerated="true">Provides a scheme-qualified identifier for the underlying package component when its full product definition is not provided elsewhere in the document.</xsd:documentation>
          </xsd:annotation>
        </xsd:element>
        <xsd:element name="productDefinitionReference" type="ProductReference">
          <xsd:annotation>
            <xsd:documentation fpml-annotation:aiGenerated="true">An intra-document reference to the full FpML definition of the underlying product represented by this package component.</xsd:documentation>
          </xsd:annotation>
        </xsd:element>
      </xsd:choice>
      <xsd:choice minOccurs="0">
        <xsd:annotation>
          <xsd:documentation>For cross-asset packages it may be necessary to use either PayerReceiver.model or BuyerSeller.model whichever is logically applicable to the component product. For example, a bond will require BuyerSeller.model but a swap will require PayerReceiver.model.</xsd:documentation>
        </xsd:annotation>
        <xsd:group minOccurs="0" ref="PayerReceiver.model" />
        <xsd:group minOccurs="0" ref="BuyerSeller.model" />
      </xsd:choice>
      <xsd:element name="hedgeRiskWeight" type="xsd:double" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation>Risk weight is applicable to packages with RiskNeutral hedge type. For example, a risk weight of 1.0 on each leg would means that the quantities are calculated such that the risk of both legs is equal.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
    </xsd:sequence>
    <xsd:attribute name="componentId" type="xsd:ID" use="required" />
  </xsd:complexType>
  <xsd:complexType name="ComponentTradeSideReference">
    <xsd:annotation>
      <xsd:documentation>Reference to a component of the package that defines the package trade side.</xsd:documentation>
    </xsd:annotation>
    <xsd:complexContent>
      <xsd:extension base="Reference">
        <xsd:attribute name="href" type="xsd:IDREF" use="required" ecore:reference="ComponentProduct" />
      </xsd:extension>
    </xsd:complexContent>
  </xsd:complexType>
  <xsd:complexType name="CreditApprovalModel">
    <xsd:annotation>
      <xsd:documentation fpml-annotation:aiGenerated="true">A qualified code identifying the credit approval model, with a scheme URI specifying the external code list that controls the value.</xsd:documentation>
    </xsd:annotation>
    <xsd:simpleContent>
      <xsd:extension base="Scheme">
        <xsd:attribute name="creditApprovalModelScheme" type="NonEmptyURI" default="http://www.fpml.org/coding-scheme/credit-approval-model" />
      </xsd:extension>
    </xsd:simpleContent>
  </xsd:complexType>
  <xsd:complexType name="CreditLimitReport">
    <xsd:annotation>
      <xsd:documentation fpml-annotation:aiGenerated="true">A notification conveying credit limit information, together with optional party and account data relevant to the report.</xsd:documentation>
    </xsd:annotation>
    <xsd:complexContent>
      <xsd:extension base="NotificationMessage">
        <xsd:sequence>
          <xsd:element name="creditLimitInformation" type="CreditLimitInformation" minOccurs="0" maxOccurs="unbounded">
            <xsd:annotation>
              <xsd:documentation fpml-annotation:aiGenerated="true">A collection of credit limit details for a specific party, reported to support credit limit management in financial transactions.</xsd:documentation>
            </xsd:annotation>
          </xsd:element>
          <xsd:group ref="PartiesAndAccounts.model" minOccurs="0" />
        </xsd:sequence>
      </xsd:extension>
    </xsd:complexContent>
  </xsd:complexType>
  <xsd:complexType name="CreditLimitResponse">
    <xsd:annotation>
      <xsd:documentation fpml-annotation:aiGenerated="true">A notification conveying the outcome of a credit limit check, with an optional reason and identification of the relevant parties and accounts.</xsd:documentation>
    </xsd:annotation>
    <xsd:complexContent>
      <xsd:extension base="NotificationMessage">
        <xsd:sequence>
          <xsd:element name="response" type="SetCreditLimitResponseEnum" minOccurs="0">
            <xsd:annotation>
              <xsd:documentation fpml-annotation:aiGenerated="true">Provides the classified outcome of the credit approval request to which the notification and any accompanying reason, parties, or accounts relate.</xsd:documentation>
            </xsd:annotation>
          </xsd:element>
          <xsd:element name="reason" type="CreditLimitCheckReason" minOccurs="0">
            <xsd:annotation>
              <xsd:documentation fpml-annotation:aiGenerated="true">Provides information explaining the outcome of the credit limit action indicated by the associated response.</xsd:documentation>
            </xsd:annotation>
          </xsd:element>
          <xsd:group ref="PartiesAndAccounts.model" minOccurs="0" />
        </xsd:sequence>
      </xsd:extension>
    </xsd:complexContent>
  </xsd:complexType>
  <xsd:complexType name="CreditLimitCheckReason">
    <xsd:annotation>
      <xsd:documentation fpml-annotation:aiGenerated="true">Reason associated with a pre-execution credit limit check, represented by a reason code with an optional explanatory description, or by a description when no code is supplied.</xsd:documentation>
    </xsd:annotation>
    <xsd:choice>
      <xsd:sequence>
        <xsd:element name="reasonCode" type="CreditLimitCheckReasonCode">
          <xsd:annotation>
            <xsd:documentation>reason codes for credit limit check messages</xsd:documentation>
          </xsd:annotation>
        </xsd:element>
        <xsd:element name="description" type="String" minOccurs="0">
          <xsd:annotation>
            <xsd:documentation fpml-annotation:aiGenerated="true">A textual explanation of the reason reported in a credit limit check message, clarifying a standardized reason code or conveying the reason directly.</xsd:documentation>
          </xsd:annotation>
        </xsd:element>
      </xsd:sequence>
      <xsd:element name="description" type="String">
        <xsd:annotation>
          <xsd:documentation>free form description of the reason</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
    </xsd:choice>
  </xsd:complexType>
  <xsd:complexType name="CreditLimitCheckReasonCode">
    <xsd:annotation>
      <xsd:documentation fpml-annotation:aiGenerated="true">A qualified code identifying the reason associated with a credit limit check, with the scheme URI specifying the external controlling code list.</xsd:documentation>
    </xsd:annotation>
    <xsd:simpleContent>
      <xsd:extension base="Scheme">
        <xsd:attribute name="creditLimitCheckReasonScheme" type="NonEmptyURI" default="http://www.fpml.org/coding-scheme/credit-limit-check-reason" />
      </xsd:extension>
    </xsd:simpleContent>
  </xsd:complexType>
  <xsd:complexType name="CreditLimitExtended">
    <xsd:annotation>
      <xsd:documentation fpml-annotation:aiGenerated="true">A credit limit with applicability constraints, extended with optional indicators for revalidation in request-for-quote and order contexts.</xsd:documentation>
    </xsd:annotation>
    <xsd:complexContent>
      <xsd:extension base="CreditLimit">
        <xsd:sequence>
          <xsd:element name="rfqRevalidation" type="xsd:boolean" minOccurs="0">
            <xsd:annotation>
              <xsd:documentation fpml-annotation:aiGenerated="true">Indicates whether the request for quote requires revalidation following extension of the applicable credit limit.</xsd:documentation>
            </xsd:annotation>
          </xsd:element>
          <xsd:element name="orderRevalidation" type="xsd:boolean" minOccurs="0">
            <xsd:annotation>
              <xsd:documentation fpml-annotation:aiGenerated="true">Indicates whether affected orders require revalidation following the reported extension of a pre-execution credit limit.</xsd:documentation>
            </xsd:annotation>
          </xsd:element>
        </xsd:sequence>
      </xsd:extension>
    </xsd:complexContent>
  </xsd:complexType>
  <xsd:complexType name="CreditLimitInformationExtended">
    <xsd:annotation>
      <xsd:documentation fpml-annotation:aiGenerated="true">Information defining a pre-execution credit limit context through optional party trade details, limit model identification, and associated extended limit records.</xsd:documentation>
    </xsd:annotation>
    <xsd:sequence>
      <xsd:element name="partyInformation" type="PartyTradeInformation" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">Provides party-specific additional information recorded against the trade in the context of its credit limit model and associated credit limits.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="limitModel" type="LimitModelEnum" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">Identifies the type of credit approval request applicable to the party and associated credit limit information.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="creditLimit" type="CreditLimitExtended" minOccurs="0" maxOccurs="unbounded">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">Provides a credit limit, including its applicability constraints, associated with the party information and limit model for pre-execution credit assessment.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
    </xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="CreditRiskLimit">
    <xsd:annotation>
      <xsd:documentation fpml-annotation:aiGenerated="true">Definition of a credit limit check outcome, expressing full approval or the requested and approved quantity, together with reasons, validity expiry, supporting limit references, and original request details.</xsd:documentation>
    </xsd:annotation>
    <xsd:sequence>
      <xsd:choice minOccurs="0">
        <xsd:element name="fullApproval" type="xsd:boolean">
          <xsd:annotation>
            <xsd:documentation fpml-annotation:aiGenerated="true">Indicates whether the credit limit check approved the request in full, without separate requested and approved quantitative values.</xsd:documentation>
          </xsd:annotation>
        </xsd:element>
        <xsd:sequence>
          <xsd:element name="requestedNotionalAmount" type="Money" minOccurs="0">
            <xsd:annotation>
              <xsd:documentation>Specifies the fixed amount requested expressed as notional amount.</xsd:documentation>
            </xsd:annotation>
          </xsd:element>
          <xsd:element name="approvedNotionalAmount" type="Money" minOccurs="0">
            <xsd:annotation>
              <xsd:documentation>(partial approval) Specifies the fixed amount approved expressed as notional amount.</xsd:documentation>
            </xsd:annotation>
          </xsd:element>
        </xsd:sequence>
        <xsd:sequence>
          <xsd:element name="requestedNumberOfOptions" type="xsd:decimal" minOccurs="0">
            <xsd:annotation>
              <xsd:documentation>(partial approval) Specifies the fixed amount approved expressed as number of options.</xsd:documentation>
            </xsd:annotation>
          </xsd:element>
          <xsd:element name="approvedNumberOfOptions" type="xsd:decimal" minOccurs="0">
            <xsd:annotation>
              <xsd:documentation>(partial approval) Specifies the fixed amount approved expressed as number of options.</xsd:documentation>
            </xsd:annotation>
          </xsd:element>
        </xsd:sequence>
        <xsd:sequence>
          <xsd:element name="requestedNumberOfUnits" type="xsd:decimal" minOccurs="0">
            <xsd:annotation>
              <xsd:documentation>(partial approval) Specifies the fixed amount approved expressed as number of units.</xsd:documentation>
            </xsd:annotation>
          </xsd:element>
          <xsd:element name="approvedNumberOfUnits" type="xsd:decimal" minOccurs="0">
            <xsd:annotation>
              <xsd:documentation>(partial approval) Specifies the fixed amount approved expressed as number of units.</xsd:documentation>
            </xsd:annotation>
          </xsd:element>
        </xsd:sequence>
      </xsd:choice>
      <xsd:element name="reason" type="CreditLimitCheckReason" minOccurs="0" maxOccurs="unbounded">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">Records a reason supporting the credit risk limit determination, whether expressed as full approval or an approved notional amount, option count, or unit count.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="limitExpiryTimeStamp" type="xsd:dateTime" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">The date and time after which the credit risk limit approval is no longer valid for the pre-trade request.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="creditLimitReference" type="CreditLimitReference" minOccurs="0" maxOccurs="unbounded">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">Provides references identifying a specific credit limit approval, including the approving party and approval instance, for tracking the applicable authorization.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="originalRequestDetails" type="OriginalRequestDetails" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">Provides information from the initiating request to which the credit risk limit assessment, approval amounts, reasons, references, and expiry apply.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
    </xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="CreditRiskLimitRefused">
    <xsd:annotation>
      <xsd:documentation fpml-annotation:aiGenerated="true">Information describing a refused credit risk limit check and linking its rationale, expiry, and applicable credit limit references to the originating request.</xsd:documentation>
    </xsd:annotation>
    <xsd:sequence>
      <xsd:element name="limitRefused" type="xsd:boolean" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">Indicates whether a pre-execution credit limit check refused the requested limit, for which associated reasons, expiry information, and references may be recorded.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="reason" type="CreditLimitCheckReason" minOccurs="0" maxOccurs="unbounded">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">Specifies a reason for refusing the requested credit risk limit, explaining the negative pre-execution credit check outcome.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="limitExpiryTimeStamp" type="xsd:dateTime" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">Specifies the date and time at which the credit risk limit associated with the refusal expires.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="creditLimitReference" type="CreditLimitReference" minOccurs="0" maxOccurs="unbounded">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">Identifies a specific credit limit approval by its approving party and approval instance for tracking within the reported credit risk limit refusal.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="originalRequestDetails" type="OriginalRequestDetails" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">Provides details of the original request associated with the response indicating refusal of a credit risk limit.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
    </xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="HedgeType">
    <xsd:annotation>
      <xsd:documentation fpml-annotation:aiGenerated="true">A non-empty coded identifier for a hedge classification, with a scheme URI identifying the external code list or reference catalog that controls the value.</xsd:documentation>
    </xsd:annotation>
    <xsd:simpleContent>
      <xsd:extension base="NonEmptyScheme">
        <xsd:attribute name="hedgeTypeScheme" type="NonEmptyURI" default="http://www.fpml.org/coding-scheme/hedge-type">
          <xsd:annotation>
            <xsd:documentation>The identifier scheme used with this hedgeType. A unique URI to determine the type of hedging.</xsd:documentation>
          </xsd:annotation>
        </xsd:attribute>
      </xsd:extension>
    </xsd:simpleContent>
  </xsd:complexType>
  <xsd:complexType name="LimitCheckApproved">
    <xsd:annotation>
      <xsd:documentation fpml-annotation:aiGenerated="true">A notification that a pre-execution credit limit check has been approved, optionally identifying the applicable credit risk limit and associated parties and accounts.</xsd:documentation>
    </xsd:annotation>
    <xsd:complexContent>
      <xsd:extension base="NotificationMessage">
        <xsd:sequence>
          <xsd:element name="creditRiskLimit" type="CreditRiskLimit" minOccurs="0">
            <xsd:annotation>
              <xsd:documentation fpml-annotation:aiGenerated="true">Indicates the credit risk limit to which approval applies in a pre-execution limit check notification concerning the identified parties and accounts.</xsd:documentation>
            </xsd:annotation>
          </xsd:element>
          <xsd:group ref="PartiesAndAccounts.model" minOccurs="0" />
        </xsd:sequence>
      </xsd:extension>
    </xsd:complexContent>
  </xsd:complexType>
  <xsd:complexType name="LimitCheckRefused">
    <xsd:annotation>
      <xsd:documentation fpml-annotation:aiGenerated="true">A notification of refusal of a pre-execution credit limit check, optionally providing the refused credit risk limit and associated parties and accounts.</xsd:documentation>
    </xsd:annotation>
    <xsd:complexContent>
      <xsd:extension base="NotificationMessage">
        <xsd:sequence>
          <xsd:element name="creditRiskLimit" type="CreditRiskLimitRefused" minOccurs="0">
            <xsd:annotation>
              <xsd:documentation fpml-annotation:aiGenerated="true">Indicates that the notified limit-check refusal concerns a credit risk limit applicable to the parties and accounts identified in the message.</xsd:documentation>
            </xsd:annotation>
          </xsd:element>
          <xsd:group ref="PartiesAndAccounts.model" minOccurs="0" />
        </xsd:sequence>
      </xsd:extension>
    </xsd:complexContent>
  </xsd:complexType>
  <xsd:complexType name="OrderBookId">
    <xsd:annotation>
      <xsd:documentation fpml-annotation:aiGenerated="true">A qualified identifier for an order book, comprising a text token and an optional URI specifying its external controlling code list or reference catalog.</xsd:documentation>
    </xsd:annotation>
    <xsd:simpleContent>
      <xsd:extension base="Scheme">
        <xsd:attribute name="orderBookIdScheme" type="NonEmptyURI" />
      </xsd:extension>
    </xsd:simpleContent>
  </xsd:complexType>
  <xsd:complexType name="OrderFill">
    <xsd:annotation>
      <xsd:documentation fpml-annotation:aiGenerated="true">A record of an order execution, identifying the order and fill and specifying the executed size, price, time, and counterparty.</xsd:documentation>
    </xsd:annotation>
    <xsd:sequence>
      <xsd:element name="orderId" type="NormalizedString" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">An identifier for the order to which the reported fill applies, enabling the execution details to be associated with the originating order.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="fillId" type="NormalizedString" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">A normalized string identifying the order fill associated with its execution size, price, time, and counterparty.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="size" type="xsd:decimal" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">The quantity of the referenced order executed in this fill at the associated price and execution date and time.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="price" type="xsd:decimal" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">The decimal price at which the specified fill size was executed against the identified order.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="executionDateTime" type="xsd:dateTime" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">The date and time at which execution of the identified order fill occurred in the order management process.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="counterpartyReference" type="PartyReference" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">An intra-document reference to the party acting as the counterparty for the reported order fill.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
    </xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="OrderPrice">
    <xsd:annotation>
      <xsd:documentation fpml-annotation:aiGenerated="true">Numerical pricing information for an order, including supplementary, stop, pegged, and indicative auction measures, together with applicable quote units, multiplier, and currency.</xsd:documentation>
    </xsd:annotation>
    <xsd:sequence>
      <xsd:element name="value" type="xsd:decimal" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">The primary decimal price specified for the order, interpreted using the associated price units, multiplier, and currency when provided.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="additionalValue" type="xsd:decimal" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">A supplementary decimal component of the order price, interpreted using the specified price units, multiplier, and currency.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="stopValue" type="xsd:decimal" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">The price threshold that triggers activation of a stop order, interpreted using the associated price units, multiplier, and currency.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="peggedValue" type="xsd:decimal" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">Represents the decimal pegging component of an order price, interpreted according to the associated price units, multiplier, and currency.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="indicativeAuctionValue" type="xsd:decimal" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">The indicative price value associated with an auction order, expressed according to the specified price units, multiplier, and currency.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="indicativeAuctionVolume" type="xsd:decimal" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">The indicative volume associated with the auction price represented by the corresponding indicative auction value.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="priceUnits" type="PriceQuoteUnits" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">Specifies the measurement units used to interpret the decimal price values associated with the order.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="priceMultiplier" type="xsd:decimal" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">Specifies the decimal factor applied to the stated order price values when determining the effective quoted price.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="priceCurrency" type="Currency" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">Provides the currency or fund code applicable to the order price values, according to the specified currency coding scheme.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
    </xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="OrderPriority">
    <xsd:annotation>
      <xsd:documentation fpml-annotation:aiGenerated="true">A structure for recording the temporal and quantitative attributes used to characterize an order’s priority.</xsd:documentation>
    </xsd:annotation>
    <xsd:sequence>
      <xsd:element name="priorityChangeTimestamp" type="xsd:dateTime" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">The date and time when the order's priority changed, providing the temporal reference for the associated priority size.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="prioritySize" type="xsd:decimal" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">Specifies the order quantity associated with its priority as of the recorded priority change timestamp.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
    </xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="OrderProductSummary">
    <xsd:annotation>
      <xsd:documentation fpml-annotation:aiGenerated="true">A summary of the product associated with an order, providing identifying, timing, underlying, economic, exercise, and settlement information needed to characterize the ordered instrument.</xsd:documentation>
    </xsd:annotation>
    <xsd:sequence>
      <xsd:element name="productId" type="ProductId" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">A scheme-qualified identifier for the financial product summarized for an order, distinct from the identifier of any underlying instrument.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="expirationDate" type="xsd:dateTime" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">The date and time at which the financial product summarized for the order reaches its expiration.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="terminationDate" type="xsd:dateTime" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">The date and time at which the financial product represented by the order reaches its contractual termination.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="leg2Currency" type="Currency" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">The currency code associated with the second leg of the product summarized for an order.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="underlyingInstrumentId" type="InstrumentId" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">A scheme-qualified short-form identifier for the security underlying the product represented by the order summary.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="optionType" type="OptionTypeEnum" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">Identifies the contractual option classification for the ordered product, complementing its underlying instrument, strike, exercise style, and settlement terms.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="strike" type="OrderStrike" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">Provides the strike terms used to determine exercise of the option represented by the order product summary.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="quantityCurrency" type="Currency" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">Identifies the currency or fund code in which the order quantity for the summarized product is expressed.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="quantityUnit" type="QuantityUnit" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">Specifies the scheme-qualified unit of measure used to express the quantity associated with the summarized order product.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="exerciseStyle" type="ExerciseStyleEnum" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">Specifies when the holder may exercise the option rights represented in the order product summary, using American, Bermuda, or European exercise conventions.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="settlementType" type="SettlementTypeEnum" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">Specifies the method by which the transaction represented in the order product summary is to be settled upon exercise.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="upfrontPayment" type="OrderUpfrontPayment" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">Provides the upfront payment terms associated with the product represented by the order summary for pre-trade processing.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
    </xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="OrderRoles">
    <xsd:annotation>
      <xsd:documentation fpml-annotation:aiGenerated="true">Identifies the parties and persons performing roles in an order and records associated execution characteristics, including party side, trading capacity, liquidity provision, waiver status, order behavior, and self-execution prevention.</xsd:documentation>
    </xsd:annotation>
    <xsd:sequence>
      <xsd:element name="orderingPartyReference" type="PartyReference" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">Identifies, by intra-document reference, the party that places the order within the associated pre-trade order process.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="quotingPartyReference" type="PartyReference" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">Identifies the party providing the quote for the order, by reference to a party defined elsewhere in the document.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="quotingPartySide" type="BuySellEnum" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">Indicates whether the quoting party acts as buyer or seller in relation to the associated order.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="tradingVenuePartyReference" type="PartyReference" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">An intra-document reference to the party acting as the trading venue associated with the order.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="clientPartyReference" type="PartyReference" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">An intra-document reference to the party acting as the client for the order or related pre-trade activity.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="arrangingPersonReference" type="PersonReference" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">An intra-document reference to the individual acting in the arranging role for the order represented by the associated order role information.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="investmentDeciderReference" type="PersonReference" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">A reference to the individual responsible for making the investment decision associated with the order.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="executionDeciderReference" type="PersonReference" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">Identifies the individual responsible for determining how an order is executed, separately from the person responsible for the investment decision.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="nonExecutingBrokerReference" type="PartyReference" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">Reference to the party acting as a broker in relation to the order but not executing it.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="tradingCapacity" type="String" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">Records the capacity in which a party acts when participating in the order or resulting execution.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="liquidityProvision" type="xsd:boolean" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">Indicates whether the order is designated as providing liquidity in the market associated with the order management or execution process.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="tradingWaiver" type="xsd:boolean" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">Indicates whether the order involving the identified parties and persons is subject to a waiver from applicable trading requirements.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="passiveOrder" type="xsd:boolean" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">Indicates whether the submitted order is designated as taking the passive role for the relevant trading activity.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="passiveOrAggressive" type="PassiveOrAggressiveEnum" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">Indicates, for a partial or complete order fill, whether the order provided liquidity while resting on the order book or initiated the trade and took liquidity.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="selfExecutionPrevented" type="xsd:boolean" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">Indicates whether execution of the order against another order associated with the same party was prevented.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
    </xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="OrderReport">
    <xsd:annotation>
      <xsd:documentation fpml-annotation:aiGenerated="true">A record conveying the identity, submission context, terms, current status, and execution outcome of an order, including fill quantities and any resulting trade or credit limit references.</xsd:documentation>
    </xsd:annotation>
    <xsd:sequence>
      <xsd:choice>
        <xsd:sequence>
          <xsd:element name="requesterOrderId" type="NormalizedString">
            <xsd:annotation>
              <xsd:documentation fpml-annotation:aiGenerated="true">The identifier assigned by the requesting party to correlate the reported order with its own order records.</xsd:documentation>
            </xsd:annotation>
          </xsd:element>
          <xsd:element name="orderId" type="NormalizedString" minOccurs="0">
            <xsd:annotation>
              <xsd:documentation fpml-annotation:aiGenerated="true">A normalized identifier used to correlate the reported order with its status, quantities, fills, and resulting trade information.</xsd:documentation>
            </xsd:annotation>
          </xsd:element>
        </xsd:sequence>
        <xsd:element name="orderId" type="NormalizedString">
          <xsd:annotation>
            <xsd:documentation fpml-annotation:aiGenerated="true">Identifies the order represented by the report, linking its status, pricing, size, fill, and resulting trade information.</xsd:documentation>
          </xsd:annotation>
        </xsd:element>
      </xsd:choice>
      <xsd:element name="receiverOrderId" type="NormalizedString" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">An identifier assigned by the receiving party to correlate the reported order within its order management records.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="strategyId" type="NormalizedString" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">A normalized string identifying the strategy associated with the order represented by this order report.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="submittedTime" type="xsd:dateTime" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">The date and time at which the reported order was submitted by the requester for processing or execution.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="receivedTime" type="xsd:dateTime" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">The date and time at which the order identified in the report was received by the receiving party.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="roles" type="OrderRoles" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">Contains role information for the reported order, identifying the capacities in which associated participants act during its handling.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="directElectronicAccess" type="xsd:boolean" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">Indicates whether the reported order was submitted to an execution facility using direct electronic access.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="isAggregated" type="xsd:boolean" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">Indicates whether the reported order represents an aggregation of multiple underlying orders for order management and execution reporting.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="additionalInfo" type="String" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">Provides supplementary free-form information concerning the reported order that is not represented by the report’s dedicated identifiers, classifications, pricing, status, or execution fields.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="orderBookId" type="OrderBookId" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">Provides the scheme-qualified identifier of the order book associated with the order represented in the report.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="instrumentId" type="InstrumentId" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">Specifies a scheme-qualified short-form identifier for the security that is the subject of the reported order.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="order" type="String" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation>echo back the order (placeholder type for now)</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="orderClassification" type="String" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">A textual value assigning the reported order to a category used in its management and reporting.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="validity" type="OrderValidity" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">Specifies the conditions governing the period during which the reported order remains eligible for execution.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="tradingPhases" type="NormalizedString" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">Identifies the trading phases applicable to the reported order, represented as a normalized textual value.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="priority" type="OrderPriority" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">Identifies the relative handling precedence assigned to the order represented by the report during order management processing.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="productSummary" type="OrderProductSummary" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">Provides summarized information about the financial product to which the reported order, including its price, status, size, and execution details, relates.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="price" type="OrderPrice" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">Specifies the structured pricing terms under which the reported order is submitted, managed, or executed.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="status" type="OrderStatusEnum" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">Specifies the lifecycle state of the reported order, providing a standardized classification distinct from any supplementary status code.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="statusCode" type="String" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">A textual code used to identify the reported status of the order within the order management process.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="shortSale" type="xsd:boolean" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">Indicates whether the reported order is designated as a short sale for order handling and reporting purposes.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="routingStrategy" type="String" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">Specifies the strategy applied when routing the reported order through the order management and execution process.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:sequence>
        <xsd:element name="reason" type="Reason" minOccurs="0">
          <xsd:annotation>
            <xsd:documentation>Reason for a rejected quote</xsd:documentation>
          </xsd:annotation>
        </xsd:element>
        <xsd:element name="counterofferQuote" type="String" minOccurs="0">
          <xsd:annotation>
            <xsd:documentation>Supply a counter-offer quote, e.g. if order is rejected / DUMMY placeholder.</xsd:documentation>
          </xsd:annotation>
        </xsd:element>
      </xsd:sequence>
      <xsd:sequence>
        <xsd:element name="totalSize" type="xsd:decimal" minOccurs="0">
          <xsd:annotation>
            <xsd:documentation>Number of units of the product being ordered.</xsd:documentation>
          </xsd:annotation>
        </xsd:element>
        <xsd:element name="displayedSize" type="xsd:decimal" minOccurs="0">
          <xsd:annotation>
            <xsd:documentation>Number of units of the product being displayed.</xsd:documentation>
          </xsd:annotation>
        </xsd:element>
        <xsd:element name="minimumTotalFillSize" type="xsd:decimal" minOccurs="0">
          <xsd:annotation>
            <xsd:documentation>Mimimum size that can be filled in total</xsd:documentation>
          </xsd:annotation>
        </xsd:element>
        <xsd:element name="minimumSingleFillSize" type="xsd:decimal" minOccurs="0">
          <xsd:annotation>
            <xsd:documentation>Minimum size that can be filled in a single fill.</xsd:documentation>
          </xsd:annotation>
        </xsd:element>
        <xsd:element name="minimumOnFirstFillOnly" type="xsd:boolean" minOccurs="0">
          <xsd:annotation>
            <xsd:documentation>Does minimum execution size apply only to first fill?</xsd:documentation>
          </xsd:annotation>
        </xsd:element>
        <xsd:element name="fills" type="xsd:integer" minOccurs="0">
          <xsd:annotation>
            <xsd:documentation>Number of fills so far.</xsd:documentation>
          </xsd:annotation>
        </xsd:element>
        <xsd:element name="filledSize" type="xsd:decimal" minOccurs="0">
          <xsd:annotation>
            <xsd:documentation>Number of units of the product filled so far</xsd:documentation>
          </xsd:annotation>
        </xsd:element>
        <xsd:element name="remainingSize" type="xsd:decimal" minOccurs="0">
          <xsd:annotation>
            <xsd:documentation>Number of units of the product remaining to be filled</xsd:documentation>
          </xsd:annotation>
        </xsd:element>
        <xsd:element name="fill" type="OrderFill" minOccurs="0" maxOccurs="unbounded">
          <xsd:annotation>
            <xsd:documentation>Info about the fills</xsd:documentation>
          </xsd:annotation>
        </xsd:element>
        <xsd:choice minOccurs="0">
          <xsd:element name="trade" type="Trade">
            <xsd:annotation>
              <xsd:documentation>trade description.</xsd:documentation>
            </xsd:annotation>
          </xsd:element>
          <xsd:element name="tradeIdentifier" type="TradeIdentifier" maxOccurs="unbounded">
            <xsd:annotation>
              <xsd:documentation fpml-annotation:aiGenerated="true">Identifies a trade associated with execution of the reported order, using an identifier issued by the indicated party.</xsd:documentation>
            </xsd:annotation>
          </xsd:element>
          <xsd:element name="tradePackage" type="TradePackage">
            <xsd:annotation>
              <xsd:documentation fpml-annotation:aiGenerated="true">A bundle of trades associated with the reported order and collected as a single unit for reporting.</xsd:documentation>
            </xsd:annotation>
          </xsd:element>
        </xsd:choice>
        <xsd:element name="creditLimitReference" type="CreditLimitReference" minOccurs="0" maxOccurs="unbounded">
          <xsd:annotation>
            <xsd:documentation fpml-annotation:aiGenerated="true">A reference to a specific credit limit approval associated with the reported order, supporting identification of the approving party and approval instance.</xsd:documentation>
          </xsd:annotation>
        </xsd:element>
      </xsd:sequence>
    </xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="OrderStatus">
    <xsd:annotation>
      <xsd:documentation fpml-annotation:aiGenerated="true">A record of an order’s current lifecycle state, identified by requester or assigned identifiers, with optional submission details and either response rationale and counteroffer information or execution progress, resulting trades, and associated credit limit references.</xsd:documentation>
    </xsd:annotation>
    <xsd:sequence>
      <xsd:choice>
        <xsd:sequence>
          <xsd:element name="requesterOrderId" type="NormalizedString">
            <xsd:annotation>
              <xsd:documentation fpml-annotation:aiGenerated="true">An identifier assigned by the order requester, used to correlate the reported status with the requester’s original order submission.</xsd:documentation>
            </xsd:annotation>
          </xsd:element>
          <xsd:element name="orderId" type="NormalizedString" minOccurs="0">
            <xsd:annotation>
              <xsd:documentation fpml-annotation:aiGenerated="true">An identifier for associating the reported status, execution details, and related trade information with the corresponding order.</xsd:documentation>
            </xsd:annotation>
          </xsd:element>
        </xsd:sequence>
        <xsd:element name="orderId" type="NormalizedString">
          <xsd:annotation>
            <xsd:documentation fpml-annotation:aiGenerated="true">Identifies the order to which the reported status, submission time, fill information, and related trade or credit references apply.</xsd:documentation>
          </xsd:annotation>
        </xsd:element>
      </xsd:choice>
      <xsd:element name="submittedTime" type="xsd:dateTime" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">The date and time at which the order associated with the reported status was submitted.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="order" type="String" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation>echo back the order (placeholder type for now)</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="status" type="OrderStatusEnum" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">The current lifecycle state of the identified order, providing context for any reported reason, counteroffer, fill quantities, trade details, or credit limit references.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:choice minOccurs="0">
        <xsd:sequence>
          <xsd:element name="reason" type="Reason" minOccurs="0">
            <xsd:annotation>
              <xsd:documentation>Reason for a rejected quote</xsd:documentation>
            </xsd:annotation>
          </xsd:element>
          <xsd:element name="counterofferQuote" type="String" minOccurs="0">
            <xsd:annotation>
              <xsd:documentation>Supply a counter-offer quote, e.g. if order is rejected / DUMMY placeholder.</xsd:documentation>
            </xsd:annotation>
          </xsd:element>
        </xsd:sequence>
        <xsd:sequence>
          <xsd:element name="totalSize" type="xsd:decimal" minOccurs="0">
            <xsd:annotation>
              <xsd:documentation>Number of units of the product being ordered.</xsd:documentation>
            </xsd:annotation>
          </xsd:element>
          <xsd:element name="fills" type="xsd:integer" minOccurs="0">
            <xsd:annotation>
              <xsd:documentation>Number of fills so far.</xsd:documentation>
            </xsd:annotation>
          </xsd:element>
          <xsd:element name="filledSize" type="xsd:decimal" minOccurs="0">
            <xsd:annotation>
              <xsd:documentation>Number of units of the product filled so far</xsd:documentation>
            </xsd:annotation>
          </xsd:element>
          <xsd:element name="remainingSize" type="xsd:decimal" minOccurs="0">
            <xsd:annotation>
              <xsd:documentation>Number of units of the product remaining to be filled</xsd:documentation>
            </xsd:annotation>
          </xsd:element>
          <xsd:element name="fill" type="OrderFill" minOccurs="0" maxOccurs="unbounded">
            <xsd:annotation>
              <xsd:documentation>Info about the fills</xsd:documentation>
            </xsd:annotation>
          </xsd:element>
          <xsd:choice minOccurs="0">
            <xsd:element name="trade" type="Trade">
              <xsd:annotation>
                <xsd:documentation>trade description.</xsd:documentation>
              </xsd:annotation>
            </xsd:element>
            <xsd:element name="tradeIdentifier" type="TradeIdentifier" maxOccurs="unbounded">
              <xsd:annotation>
                <xsd:documentation fpml-annotation:aiGenerated="true">Identifies a trade resulting from execution of the order, using an identifier issued by the indicated party.</xsd:documentation>
              </xsd:annotation>
            </xsd:element>
            <xsd:element name="tradePackage" type="TradePackage">
              <xsd:annotation>
                <xsd:documentation fpml-annotation:aiGenerated="true">A bundle of trades resulting from order execution and collected as a single unit for reporting.</xsd:documentation>
              </xsd:annotation>
            </xsd:element>
          </xsd:choice>
          <xsd:element name="creditLimitReference" type="CreditLimitReference" minOccurs="0" maxOccurs="unbounded">
            <xsd:annotation>
              <xsd:documentation fpml-annotation:aiGenerated="true">Reference identifying a specific credit limit approval associated with the order, including its approving party and approval instance.</xsd:documentation>
            </xsd:annotation>
          </xsd:element>
        </xsd:sequence>
      </xsd:choice>
    </xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="OrderStatusNotification">
    <xsd:annotation>
      <xsd:documentation fpml-annotation:aiGenerated="true">A notification reporting the status of one or more orders and, optionally, the parties and accounts relevant to the notification.</xsd:documentation>
    </xsd:annotation>
    <xsd:complexContent>
      <xsd:extension base="NotificationMessage">
        <xsd:sequence>
          <xsd:element name="orderStatus" type="OrderStatus" minOccurs="0" maxOccurs="unbounded">
            <xsd:annotation>
              <xsd:documentation fpml-annotation:aiGenerated="true">Provides the reported status details for an individual order addressed by the order status notification message.</xsd:documentation>
            </xsd:annotation>
          </xsd:element>
          <xsd:group ref="PartiesAndAccounts.model" minOccurs="0" />
        </xsd:sequence>
      </xsd:extension>
    </xsd:complexContent>
  </xsd:complexType>
  <xsd:complexType name="OrderStatusReport">
    <xsd:annotation>
      <xsd:documentation fpml-annotation:aiGenerated="true">A correctable or retractable request message for communicating order status information, with optional identification of associated parties and accounts.</xsd:documentation>
    </xsd:annotation>
    <xsd:complexContent>
      <xsd:extension base="CorrectableRequestMessage">
        <xsd:sequence>
          <xsd:element name="orderStatus" type="OrderReport" minOccurs="0" maxOccurs="unbounded">
            <xsd:annotation>
              <xsd:documentation fpml-annotation:aiGenerated="true">The reported state and order-specific information for an individual order covered by the enclosing report.</xsd:documentation>
            </xsd:annotation>
          </xsd:element>
          <xsd:group ref="PartiesAndAccounts.model" minOccurs="0" />
        </xsd:sequence>
      </xsd:extension>
    </xsd:complexContent>
  </xsd:complexType>
  <xsd:complexType name="OrderStrike">
    <xsd:annotation>
      <xsd:documentation fpml-annotation:aiGenerated="true">A structure representing the monetary level applicable to an order, with optional price and currency denomination.</xsd:documentation>
    </xsd:annotation>
    <xsd:sequence>
      <xsd:element name="price" type="xsd:decimal" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">The decimal strike price specified for the order, expressed in the currency identified by the associated currency value.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="currency" type="Currency" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">Identifies the currency or fund code used to denominate the price specified for the order strike.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
    </xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="OrderUpfrontPayment">
    <xsd:annotation>
      <xsd:documentation fpml-annotation:aiGenerated="true">A structure that specifies an order’s upfront payment as an optional value expressed in basis points.</xsd:documentation>
    </xsd:annotation>
    <xsd:sequence>
      <xsd:element name="basisPointValue" type="xsd:decimal" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">A decimal measure of the upfront payment associated with an order, expressed as a number of basis points.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
    </xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="OrderValidity">
    <xsd:annotation>
      <xsd:documentation fpml-annotation:aiGenerated="true">Defines the temporal and conditional validity of an order through an optional validity classification, date-time boundary, and supplementary restriction.</xsd:documentation>
    </xsd:annotation>
    <xsd:sequence>
      <xsd:element name="validityType" type="String" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">A textual classification of the order’s validity, indicating the basis under which the order remains effective.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="validityPeriod" type="xsd:dateTime" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">The date and time until which the associated order remains valid for execution under its stated validity terms.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="restriction" type="String" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">Specifies a textual condition that constrains the circumstances under which the order remains valid, supplementing its validity type and period.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
    </xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="OriginalRequestDetails">
    <xsd:annotation>
      <xsd:documentation fpml-annotation:aiGenerated="true">Information identifying the trade or package associated with the original credit approval request, together with its request classification, approval model, and requesting party where provided.</xsd:documentation>
    </xsd:annotation>
    <xsd:sequence>
      <xsd:element name="requestingPartyReference" type="PartyReference" minOccurs="0" fpml-annotation:deprecated="true" fpml-annotation:deprecatedReason="Deprecated in favor of existing onBehalfOf element.">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">Identifies, by intra-document reference, the party on whose behalf the original request was made; retained for compatibility and superseded by onBehalfOf.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="creditApprovalRequestType" type="CreditApprovalRequestTypeEnum" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">Specifies the classification of the credit approval request associated with the referenced original trade, package, or their identifiers.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="creditApprovalModel" type="CreditApprovalModel" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">Identifies, under an applicable coding scheme, the model used to evaluate the credit approval request for the referenced original trade or package.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:choice minOccurs="0">
        <xsd:element name="originalTrade" type="Trade">
          <xsd:annotation>
            <xsd:documentation>Fully describes the original trade (prior to the exercise).</xsd:documentation>
          </xsd:annotation>
        </xsd:element>
        <xsd:element name="tradeIdentifier" type="TradeIdentifier" maxOccurs="unbounded">
          <xsd:annotation>
            <xsd:documentation fpml-annotation:aiGenerated="true">Identifies the original trade, prior to the exercise, through one or more identifiers issued by the indicated parties.</xsd:documentation>
          </xsd:annotation>
        </xsd:element>
        <xsd:element name="originalPackage" type="TradePackage">
          <xsd:annotation>
            <xsd:documentation>Fully describes the original trade package (prior to the exercise).</xsd:documentation>
          </xsd:annotation>
        </xsd:element>
        <xsd:element name="packageIdentifier" type="IssuerTradeId">
          <xsd:annotation>
            <xsd:documentation fpml-annotation:aiGenerated="true">Identifies the original trade package prior to the exercise using a two-part issuer trade identifier.</xsd:documentation>
          </xsd:annotation>
        </xsd:element>
      </xsd:choice>
    </xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="PackageName">
    <xsd:annotation>
      <xsd:documentation fpml-annotation:aiGenerated="true">A qualified identifier for a package, comprising a non-empty text token and an optional URI identifying its external controlling code list or reference catalog.</xsd:documentation>
    </xsd:annotation>
    <xsd:simpleContent>
      <xsd:extension base="NonEmptyScheme">
        <xsd:attribute name="packageNameScheme" type="NonEmptyURI">
          <xsd:annotation>
            <xsd:documentation>A unique URI to determine the source system providing the package name.</xsd:documentation>
          </xsd:annotation>
        </xsd:attribute>
      </xsd:extension>
    </xsd:simpleContent>
  </xsd:complexType>
  <xsd:complexType name="ProductConventions">
    <xsd:annotation>
      <xsd:documentation>ProductConventions can be used to specify conventions enforced by a trading platform.</xsd:documentation>
    </xsd:annotation>
    <xsd:sequence>
      <xsd:element name="maximumQuotePrecisionDecimal" type="xsd:int" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation>Maximum precision in decimal places for providing quotes.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="minimumFillSize" type="xsd:double" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation>Minimum size of a contract, when a given contract is traded, its size must be a multiple of this value.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="measureType" type="AssetMeasureType" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation>Name of the economic value that serves as a single quote value during negotiation and will be used to determine best bid/offer.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="quoteUnits" type="PriceQuoteUnits" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation>Units in which quote values are measured.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
    </xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="ProductDefinition">
    <xsd:annotation>
      <xsd:documentation fpml-annotation:aiGenerated="true">A specification of either an individual product or a standard package, with optional descriptive information, trading-platform conventions, and a reference to the applicable trade side.</xsd:documentation>
    </xsd:annotation>
    <xsd:sequence>
      <xsd:element name="description" type="String" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation>Optional "user-friendly" name for the product used for annotation purposes</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="conventions" type="ProductConventions" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">Specifies the product conventions enforced by the trading platform for the product or standard package represented by this definition.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:choice minOccurs="0">
        <xsd:element name="package" type="StandardPackage">
          <xsd:annotation>
            <xsd:documentation>Definition of a standard package that consists out of several products</xsd:documentation>
          </xsd:annotation>
        </xsd:element>
        <xsd:element ref="product">
          <xsd:annotation>
            <xsd:documentation>FpML product definition</xsd:documentation>
          </xsd:annotation>
        </xsd:element>
      </xsd:choice>
      <xsd:element ref="tradeSideReference" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation>If this definition is for a single product, tradeSideReference can be of type tradeSideRelativeToSwapStream and refer to the swapStream id that determines the trade side. If this definition is for a standard package, tradeSideReference can be of type tradeSideRelativeToComponent which refers to the component product that determines the trade side.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
    </xsd:sequence>
    <xsd:attribute name="id" type="xsd:ID" />
  </xsd:complexType>
  <xsd:complexType name="ProductDefinitionsHeader">
    <xsd:annotation>
      <xsd:documentation fpml-annotation:aiGenerated="true">A header that records the platform date applicable to the associated collection of product definitions within a pre-trade message.</xsd:documentation>
    </xsd:annotation>
    <xsd:sequence>
      <xsd:element name="platformDate" type="xsd:date" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">The calendar date that the platform associates with the product definitions represented by the enclosing header.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
    </xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="ProductDefinitionsReport">
    <xsd:annotation>
      <xsd:documentation>The primary use case for this message is for an execution venue to report all, or a subset of, product definitions that it supports to its customer.</xsd:documentation>
    </xsd:annotation>
    <xsd:complexContent>
      <xsd:extension base="ResponseMessage">
        <xsd:sequence>
          <xsd:element name="productDefinitionsHeader" type="ProductDefinitionsHeader" minOccurs="0">
            <xsd:annotation>
              <xsd:documentation fpml-annotation:aiGenerated="true">Provides report-specific header information for an execution venue’s response concerning the product definitions it supports for a customer.</xsd:documentation>
            </xsd:annotation>
          </xsd:element>
          <xsd:choice>
            <xsd:sequence>
              <xsd:element name="definition" type="ProductDefinition" maxOccurs="unbounded">
                <xsd:annotation>
                  <xsd:documentation fpml-annotation:aiGenerated="true">A product definition supported by the execution venue and included in the complete or selected set reported to its customer.</xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element name="queryProduct" type="QueryProduct" minOccurs="0">
                <xsd:annotation>
                  <xsd:documentation>A type representing a portfolio obtained by querying the set of trades held in a repository. It contains trades matching the intersection of all criteria specified using one or more queryParameters or trades matching the union of two or more child queryPortfolios.</xsd:documentation>
                </xsd:annotation>
              </xsd:element>
            </xsd:sequence>
            <xsd:element name="queryProduct" type="QueryProduct">
              <xsd:annotation>
                <xsd:documentation>A type representing a portfolio obtained by querying the set of trades held in a repository. It contains trades matching the intersection of all criteria specified using one or more queryParameters or trades matching the union of two or more child queryPortfolios.</xsd:documentation>
              </xsd:annotation>
            </xsd:element>
          </xsd:choice>
          <xsd:group ref="PartiesAndAccounts.model" minOccurs="0" />
        </xsd:sequence>
      </xsd:extension>
    </xsd:complexContent>
  </xsd:complexType>
  <xsd:complexType name="RequestLimitCheck">
    <xsd:annotation>
      <xsd:documentation fpml-annotation:aiGenerated="true">A correctable request message used to seek credit approval for trading or de-clearing activity in the context of specified quotations, parties, and accounts.</xsd:documentation>
    </xsd:annotation>
    <xsd:complexContent>
      <xsd:extension base="CorrectableRequestMessage2">
        <xsd:sequence>
          <xsd:element name="requestingPartyReference" type="PartyReference" minOccurs="0" fpml-annotation:deprecated="true" fpml-annotation:deprecatedReason="Deprecated in favor of existing onBehalfOf element.">
            <xsd:annotation>
              <xsd:documentation fpml-annotation:aiGenerated="true">Reference to the party on whose behalf the pre-execution credit limit check is requested; deprecated in favor of the onBehalfOf element.</xsd:documentation>
            </xsd:annotation>
          </xsd:element>
          <xsd:element name="creditApprovalRequestType" type="CreditApprovalRequestTypeEnum" minOccurs="0">
            <xsd:annotation>
              <xsd:documentation fpml-annotation:aiGenerated="true">Code indicating the type of credit approval request associated with the requested credit limit check.</xsd:documentation>
            </xsd:annotation>
          </xsd:element>
          <xsd:element name="creditApprovalModel" type="CreditApprovalModel" minOccurs="0">
            <xsd:annotation>
              <xsd:documentation>Code to indicate the credit approval model e.g., PushToPing, PushToStop, Plus1ToStop, Plus1ToPing, Ping.</xsd:documentation>
            </xsd:annotation>
          </xsd:element>
          <xsd:group ref="TradingEvents.model" minOccurs="0" />
          <xsd:sequence>
            <xsd:element name="quote" type="BasicQuotation" minOccurs="0" maxOccurs="unbounded">
              <xsd:annotation>
                <xsd:documentation fpml-annotation:aiGenerated="true">A numerical measure concerning an asset, together with its associated characteristics, used as input to the requested credit limit assessment.</xsd:documentation>
              </xsd:annotation>
            </xsd:element>
          </xsd:sequence>
          <xsd:group ref="PartiesAndAccounts.model" />
        </xsd:sequence>
      </xsd:extension>
    </xsd:complexContent>
  </xsd:complexType>
  <xsd:complexType name="RequestProductDefinitions">
    <xsd:annotation>
      <xsd:documentation>The primary use case for this message is for an execution venue customer to request product definitions of all (or a subset of) products that the execution venue supports.</xsd:documentation>
    </xsd:annotation>
    <xsd:complexContent>
      <xsd:extension base="CorrectableRequestMessage">
        <xsd:sequence>
          <xsd:element name="productDefinitionsHeader" type="ProductDefinitionsHeader" minOccurs="0">
            <xsd:annotation>
              <xsd:documentation fpml-annotation:aiGenerated="true">Provides header information applicable to a customer’s request for definitions of products supported by an execution venue.</xsd:documentation>
            </xsd:annotation>
          </xsd:element>
          <xsd:choice>
            <xsd:sequence>
              <xsd:element name="definition" type="ProductDefinition" maxOccurs="unbounded">
                <xsd:annotation>
                  <xsd:documentation fpml-annotation:aiGenerated="true">A structured specification identifying one product for which an execution venue-supported product definition is requested.</xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element name="queryProduct" type="QueryProduct" minOccurs="0">
                <xsd:annotation>
                  <xsd:documentation>A type representing a portfolio obtained by querying the set of trades held in a repository. It contains trades matching the intersection of all criteria specified using one or more queryParameters or trades matching the union of two or more child queryPortfolios.</xsd:documentation>
                </xsd:annotation>
              </xsd:element>
            </xsd:sequence>
            <xsd:element name="queryProduct" type="QueryProduct">
              <xsd:annotation>
                <xsd:documentation>A type representing a portfolio obtained by querying the set of trades held in a repository. It contains trades matching the intersection of all criteria specified using one or more queryParameters or trades matching the union of two or more child queryPortfolios.</xsd:documentation>
              </xsd:annotation>
            </xsd:element>
          </xsd:choice>
          <xsd:group ref="PartiesAndAccounts.model" minOccurs="0" />
        </xsd:sequence>
      </xsd:extension>
    </xsd:complexContent>
  </xsd:complexType>
  <xsd:complexType name="RequestProductDefinitionsRetracted">
    <xsd:annotation>
      <xsd:documentation>Message to cancel the product definition request message sent by the execution venue customer to the execution venue.</xsd:documentation>
    </xsd:annotation>
    <xsd:complexContent>
      <xsd:extension base="NonCorrectableRequestMessage">
        <xsd:sequence>
          <xsd:element name="productDefinitionsHeader" type="ProductDefinitionsHeader" minOccurs="0">
            <xsd:annotation>
              <xsd:documentation fpml-annotation:aiGenerated="true">Provides contextual header information for the product definition request being cancelled by an execution venue customer.</xsd:documentation>
            </xsd:annotation>
          </xsd:element>
          <xsd:choice>
            <xsd:sequence>
              <xsd:element name="definition" type="ProductDefinition" maxOccurs="unbounded">
                <xsd:annotation>
                  <xsd:documentation fpml-annotation:aiGenerated="true">A product definition identifying content of the prior product definition request being cancelled by the execution venue customer.</xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element name="queryProduct" type="QueryProduct" minOccurs="0">
                <xsd:annotation>
                  <xsd:documentation>A type representing a portfolio obtained by querying the set of trades held in a repository. It contains trades matching the intersection of all criteria specified using one or more queryParameters or trades matching the union of two or more child queryPortfolios.</xsd:documentation>
                </xsd:annotation>
              </xsd:element>
            </xsd:sequence>
            <xsd:element name="queryProduct" type="QueryProduct">
              <xsd:annotation>
                <xsd:documentation>A type representing a portfolio obtained by querying the set of trades held in a repository. It contains trades matching the intersection of all criteria specified using one or more queryParameters or trades matching the union of two or more child queryPortfolios.</xsd:documentation>
              </xsd:annotation>
            </xsd:element>
          </xsd:choice>
          <xsd:group ref="PartiesAndAccounts.model" minOccurs="0" />
        </xsd:sequence>
      </xsd:extension>
    </xsd:complexContent>
  </xsd:complexType>
  <xsd:complexType name="RestoreCredit">
    <xsd:annotation>
      <xsd:documentation fpml-annotation:aiGenerated="true">A request message that cannot be corrected or retracted, used to restore credit associated with specified parties and accounts and supported by optional reason and credit limit information.</xsd:documentation>
    </xsd:annotation>
    <xsd:complexContent>
      <xsd:extension base="NonCorrectableRequestMessage">
        <xsd:sequence>
          <xsd:element name="reason" type="CreditLimitCheckReason" minOccurs="0">
            <xsd:annotation>
              <xsd:documentation fpml-annotation:aiGenerated="true">Provides structured information explaining the basis for restoring credit against the associated credit limit information for the identified parties and accounts.</xsd:documentation>
            </xsd:annotation>
          </xsd:element>
          <xsd:element name="creditLimitInformation" type="CreditLimitInformationExtended" minOccurs="0" maxOccurs="unbounded">
            <xsd:annotation>
              <xsd:documentation fpml-annotation:aiGenerated="true">Provides credit limit details to be restored by the request for the identified parties and accounts.</xsd:documentation>
            </xsd:annotation>
          </xsd:element>
          <xsd:group ref="PartiesAndAccounts.model" />
        </xsd:sequence>
      </xsd:extension>
    </xsd:complexContent>
  </xsd:complexType>
  <xsd:complexType name="SetCreditLimit">
    <xsd:annotation>
      <xsd:documentation fpml-annotation:aiGenerated="true">A request message that cannot be subsequently corrected or retracted, used to provide extended credit limit information in the context of identified parties and accounts.</xsd:documentation>
    </xsd:annotation>
    <xsd:complexContent>
      <xsd:extension base="NonCorrectableRequestMessage">
        <xsd:sequence>
          <xsd:element name="creditLimitInformation" type="CreditLimitInformationExtended" minOccurs="0" maxOccurs="unbounded">
            <xsd:annotation>
              <xsd:documentation fpml-annotation:aiGenerated="true">Provides the credit limit details to be established for the parties or accounts identified in the request.</xsd:documentation>
            </xsd:annotation>
          </xsd:element>
          <xsd:group ref="PartiesAndAccounts.model" />
        </xsd:sequence>
      </xsd:extension>
    </xsd:complexContent>
  </xsd:complexType>
  <xsd:complexType name="StandardPackage">
    <xsd:annotation>
      <xsd:documentation>A standard package is a type of strategy which consists of several single instruments, also known as underlying instruments. All underlying instruments must be also specified in the product definition, so that the can be referred to by their identifier.</xsd:documentation>
    </xsd:annotation>
    <xsd:sequence>
      <xsd:element name="productId" type="ProductId" minOccurs="0" maxOccurs="unbounded">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">An identifier assigned to the standard package under a populated coding scheme, enabling the package to be referenced in pre-trade processing.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="packageName" type="PackageName" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">A scheme-qualified name identifying the standard package represented by the specified component products and their associated product identifiers.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="hedgeType" type="HedgeType" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation>Hedged type defines how quantities on each component product are calculated. If hedge type is DeltaNeutral, component products must have HedgeRiskWeights defined.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="component" type="ComponentProduct" minOccurs="0" maxOccurs="unbounded">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">Specifies an underlying instrument included in the standard package, using a product definition reference or product identifier to identify its definition.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
    </xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="SuspendCredit">
    <xsd:annotation>
      <xsd:documentation fpml-annotation:aiGenerated="true">A non-correctable request to suspend credit associated with referenced parties and accounts, with optional identification of affected credit limits and the reason for the request.</xsd:documentation>
    </xsd:annotation>
    <xsd:complexContent>
      <xsd:extension base="NonCorrectableRequestMessage">
        <xsd:sequence>
          <xsd:group ref="PartyAndAccountReferences.model" />
          <xsd:element name="creditLimit" type="CreditLimitBase" minOccurs="0" maxOccurs="unbounded">
            <xsd:annotation>
              <xsd:documentation fpml-annotation:aiGenerated="true">Describes a basic credit limit subject to suspension for the referenced party and account relationship.</xsd:documentation>
            </xsd:annotation>
          </xsd:element>
          <xsd:element name="reason" type="CreditLimitCheckReason" minOccurs="0">
            <xsd:annotation>
              <xsd:documentation fpml-annotation:aiGenerated="true">Provides the rationale for suspending credit limit checks concerning the referenced parties, accounts, and specified credit limits.</xsd:documentation>
            </xsd:annotation>
          </xsd:element>
          <xsd:group ref="PartiesAndAccounts.model" />
        </xsd:sequence>
      </xsd:extension>
    </xsd:complexContent>
  </xsd:complexType>
  <xsd:complexType name="SwapStreamSideReference">
    <xsd:annotation>
      <xsd:documentation>Reference to a swapStream of the swap that defines the trade side.</xsd:documentation>
    </xsd:annotation>
    <xsd:complexContent>
      <xsd:extension base="Reference">
        <xsd:attribute name="href" type="xsd:IDREF" use="required" ecore:reference="SwapStream" />
      </xsd:extension>
    </xsd:complexContent>
  </xsd:complexType>
  <xsd:element name="tradeSideReference" type="Reference" abstract="true">
    <xsd:annotation>
      <xsd:documentation>An abstract element used as a place holder for the substituting trade side reference depending on product type.</xsd:documentation>
    </xsd:annotation>
  </xsd:element>
  <xsd:element name="tradeSideRelativeToComponent" type="ComponentTradeSideReference" substitutionGroup="tradeSideReference">
    <xsd:annotation>
      <xsd:documentation>Refer to the component product defined within standard package definition where this field is defined.</xsd:documentation>
    </xsd:annotation>
  </xsd:element>
  <xsd:element name="tradeSideRelativeToSwapStream" type="SwapStreamSideReference" substitutionGroup="tradeSideReference">
    <xsd:annotation>
      <xsd:documentation>Refer to the swap stream defined within the product definition where this field is defined.</xsd:documentation>
    </xsd:annotation>
  </xsd:element>
<!-- Request Limit Check / Messages -->
  <xsd:element name="requestLimitCheck" type="RequestLimitCheck">
    <xsd:annotation>
      <xsd:documentation fpml-annotation:aiGenerated="true">A top-level request message for a pre-execution credit limit check that may be subsequently corrected or retracted.</xsd:documentation>
    </xsd:annotation>
  </xsd:element>
  <xsd:element name="limitCheckApproved" type="LimitCheckApproved">
    <xsd:annotation>
      <xsd:documentation fpml-annotation:aiGenerated="true">A notification message informing another system that a limit check has been approved and for which no reply is expected.</xsd:documentation>
    </xsd:annotation>
  </xsd:element>
  <xsd:element name="limitCheckRefused" type="LimitCheckRefused">
    <xsd:annotation>
      <xsd:documentation fpml-annotation:aiGenerated="true">A notification message informing another system that a limit check has been refused; the notification is not expected to receive a reply.</xsd:documentation>
    </xsd:annotation>
  </xsd:element>
  <xsd:element name="creditLimitReport" type="CreditLimitReport">
    <xsd:annotation>
      <xsd:documentation fpml-annotation:aiGenerated="true">A top-level notification message reporting credit limit information to another system without requiring a reply.</xsd:documentation>
    </xsd:annotation>
  </xsd:element>
  <xsd:element name="creditLimitException" type="Exception">
    <xsd:annotation>
      <xsd:documentation fpml-annotation:aiGenerated="true">A message informing another system that an exception has been detected during a credit limit check.</xsd:documentation>
    </xsd:annotation>
  </xsd:element>
  <xsd:element name="setCreditLimit" type="SetCreditLimit">
    <xsd:annotation>
      <xsd:documentation fpml-annotation:aiGenerated="true">A request message establishing the credit limit applied during pre-execution credit checks, which cannot subsequently be corrected or retracted.</xsd:documentation>
    </xsd:annotation>
  </xsd:element>
  <xsd:element name="creditLimitResponse" type="CreditLimitResponse">
    <xsd:annotation>
      <xsd:documentation fpml-annotation:aiGenerated="true">A notification message informing another system of the result of a pre-execution credit limit check, for which no reply is expected.</xsd:documentation>
    </xsd:annotation>
  </xsd:element>
  <xsd:element name="suspendCredit" type="SuspendCredit">
    <xsd:annotation>
      <xsd:documentation fpml-annotation:aiGenerated="true">A top-level request to suspend credit, structured as a non-correctable message that cannot be subsequently corrected or retracted.</xsd:documentation>
    </xsd:annotation>
  </xsd:element>
  <xsd:element name="restoreCredit" type="RestoreCredit">
    <xsd:annotation>
      <xsd:documentation fpml-annotation:aiGenerated="true">A request message to restore credit, defined as non-correctable and therefore not subject to subsequent correction or retraction.</xsd:documentation>
    </xsd:annotation>
  </xsd:element>
  <xsd:element name="orderStatusNotification" type="OrderStatusNotification">
    <xsd:annotation>
      <xsd:documentation fpml-annotation:aiGenerated="true">A top-level notification message informing another system of an order’s status as a business event, without requiring a reply.</xsd:documentation>
    </xsd:annotation>
  </xsd:element>
  <xsd:element name="orderStatusReport" type="OrderStatusReport">
    <xsd:annotation>
      <xsd:documentation fpml-annotation:aiGenerated="true">A top-level message conveying order status information that may be subsequently corrected or retracted after transmission.</xsd:documentation>
    </xsd:annotation>
  </xsd:element>
<!-- Other existing messages used: serviceNotification -->
<!-- Product Definitions Messages -->
  <xsd:element name="requestProductDefinitions" type="RequestProductDefinitions">
    <xsd:annotation>
      <xsd:documentation>The primary use case for this message is for an execution venue customer to request product definitions of all, or a subset of, products that the execution venue supports.</xsd:documentation>
    </xsd:annotation>
  </xsd:element>
  <xsd:element name="requestProductDefinitionsRetracted" type="RequestProductDefinitionsRetracted">
    <xsd:annotation>
      <xsd:documentation>Message to cancel the product definition request message sent by the execution venue customer to the execution venue.</xsd:documentation>
    </xsd:annotation>
  </xsd:element>
  <xsd:element name="productDefinitionsReport" type="ProductDefinitionsReport">
    <xsd:annotation>
      <xsd:documentation>The primary use case for this message is for an execution venue to report all, or a subset of, product definitions that it supports to its customer.</xsd:documentation>
    </xsd:annotation>
  </xsd:element>
  <xsd:element name="productDefinitionsException" type="Exception">
    <xsd:annotation>
      <xsd:documentation>A message sent to inform another system that some exception has been detected with the product definitions messages.</xsd:documentation>
    </xsd:annotation>
  </xsd:element>
  <xsd:element name="productDefinitionsAcknowledgement" type="Acknowledgement">
    <xsd:annotation>
      <xsd:documentation>A business acknowledgement message to indicate that the previously sent message was sucessfully processed.</xsd:documentation>
    </xsd:annotation>
  </xsd:element>
</xsd:schema>

