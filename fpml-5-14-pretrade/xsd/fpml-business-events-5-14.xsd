<xsd:schema xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" xmlns="http://www.fpml.org/FpML-5/pretrade" xmlns:dsig="http://www.w3.org/2000/09/xmldsig#" xmlns:fpml-annotation="http://www.fpml.org/annotation" xmlns:xsd="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.fpml.org/FpML-5/pretrade" ecore:documentRoot="FpML" ecore:nsPrefix="pre" ecore:package="org.fpml.pretrade" version="$Revision: 15040 $" xml:lang="en" elementFormDefault="qualified" attributeFormDefault="unqualified">
  <xsd:include schemaLocation="fpml-doc-5-14.xsd" />
  <xsd:include schemaLocation="fpml-cd-5-14.xsd" />
  <xsd:complexType name="AbstractEvent" abstract="true">
    <xsd:annotation>
      <xsd:documentation>Abstract base type for all events.</xsd:documentation>
    </xsd:annotation>
    <xsd:sequence>
      <xsd:element name="eventIdentifier" type="BusinessEventIdentifier" minOccurs="0" maxOccurs="unbounded">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">Serves to uniquely identify a business event. This structure allows for precise identification and tracking of events within financial transactions.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
    </xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="AdditionalEvent" abstract="true" fpml-annotation:extensionPoint="true">
    <xsd:annotation>
      <xsd:documentation>Abstract base type for an extension/substitution point to customize FpML and add additional events.</xsd:documentation>
    </xsd:annotation>
    <xsd:complexContent>
      <xsd:extension base="AbstractEvent" />
    </xsd:complexContent>
  </xsd:complexType>
  <xsd:complexType name="BasketChangeEvent">
    <xsd:annotation>
      <xsd:documentation>A structure indicating that the basket underlyer of the trade has changed due to client trading activity</xsd:documentation>
    </xsd:annotation>
    <xsd:complexContent>
      <xsd:extension base="ChangeEvent"></xsd:extension>
    </xsd:complexContent>
  </xsd:complexType>
  <xsd:complexType name="BusinessEventIdentifier">
    <xsd:annotation>
      <xsd:documentation>A type defining an event identifier issued by the indicated party.</xsd:documentation>
    </xsd:annotation>
    <xsd:sequence>
      <xsd:group ref="PartyAndAccountReferences.model">
        <xsd:annotation>
          <xsd:documentation>A pointer style reference to a party identifier and optionally an account identifier defined elsewhere in the document. The party referenced has allocated the trade identifier.</xsd:documentation>
        </xsd:annotation>
      </xsd:group>
      <xsd:element name="eventId" type="EventId" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">A unique identifier assigned by a party to a post-trade event. Its structure allows for the precise identification and referencing of events within financial transactions.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
    </xsd:sequence>
    <xsd:attribute name="id" type="xsd:ID" />
  </xsd:complexType>
  <xsd:complexType name="ChangeEvent" abstract="true">
    <xsd:annotation>
      <xsd:documentation>Abstract base type for non-negotiated trade change descriptions</xsd:documentation>
    </xsd:annotation>
    <xsd:complexContent>
      <xsd:extension base="AbstractEvent"></xsd:extension>
    </xsd:complexContent>
  </xsd:complexType>
  <xsd:complexType name="CorporateActionEvent">
    <xsd:annotation>
      <xsd:documentation>A structure indicating that a trade has changed due to a corporate action</xsd:documentation>
    </xsd:annotation>
    <xsd:complexContent>
      <xsd:extension base="ChangeEvent">
        <xsd:sequence>
          <xsd:element name="type" type="CorporateActionType" minOccurs="0">
            <xsd:annotation>
              <xsd:documentation fpml-annotation:aiGenerated="true">Specifies the nature of a corporate action that has occurred. This structure allows for the classification of corporate actions, such as mergers, acquisitions, or stock splits, by referencing a specific coding scheme.</xsd:documentation>
            </xsd:annotation>
          </xsd:element>
        </xsd:sequence>
      </xsd:extension>
    </xsd:complexContent>
  </xsd:complexType>
  <xsd:complexType name="CorporateActionType">
    <xsd:annotation>
      <xsd:documentation>A type that describes what type of corporate action occurred.</xsd:documentation>
    </xsd:annotation>
    <xsd:simpleContent>
      <xsd:extension base="Scheme">
        <xsd:attribute name="corporateActionScheme" type="NonEmptyURI" />
      </xsd:extension>
    </xsd:simpleContent>
  </xsd:complexType>
  <xsd:complexType name="CreditChangeEventBase">
    <xsd:annotation>
      <xsd:documentation>A structure indicating that a trade has changed due to a credit event and containing only components shared by single name, index and basket.</xsd:documentation>
    </xsd:annotation>
    <xsd:complexContent>
      <xsd:extension base="ChangeEvent">
        <xsd:sequence>
          <xsd:element name="creditEventType" type="CreditEventType" minOccurs="0">
            <xsd:annotation>
              <xsd:documentation>Specifies the type of credit event taking place.</xsd:documentation>
            </xsd:annotation>
          </xsd:element>
          <xsd:element name="eventDeterminationDate" type="xsd:date" minOccurs="0">
            <xsd:annotation>
              <xsd:documentation>The date at which a Credit Event Resolution Request Date (CERD) or Notice Delivery Date occurs.</xsd:documentation>
            </xsd:annotation>
          </xsd:element>
          <xsd:element name="auctionDate" type="xsd:date" minOccurs="0">
            <xsd:annotation>
              <xsd:documentation>The date on which the auction is scheduled to occur.</xsd:documentation>
            </xsd:annotation>
          </xsd:element>
          <xsd:element name="settlementMethod" type="CashOrPhysicalSettlementEnum" minOccurs="0">
            <xsd:annotation>
              <xsd:documentation>Specifies whether the process is to be physically settled or cash settled.</xsd:documentation>
            </xsd:annotation>
          </xsd:element>
          <xsd:element name="settlementDate" type="xsd:date" minOccurs="0">
            <xsd:annotation>
              <xsd:documentation>The date on which settlement is scheduled to occur.</xsd:documentation>
            </xsd:annotation>
          </xsd:element>
          <xsd:element name="finalPrice" type="xsd:decimal" minOccurs="0">
            <xsd:annotation>
              <xsd:documentation>The final price resulting from the auction.</xsd:documentation>
            </xsd:annotation>
          </xsd:element>
          <xsd:element name="recoveryPercent" type="xsd:decimal" minOccurs="0">
            <xsd:annotation>
              <xsd:documentation>The percentage of the original value of the asset affected by the credit event that can be recovered.</xsd:documentation>
            </xsd:annotation>
          </xsd:element>
          <xsd:element name="publiclyAvailableInformation" type="Resource" minOccurs="0" maxOccurs="unbounded">
            <xsd:annotation>
              <xsd:documentation>A public information source, e.g. a particular newspaper or electronic news service, that may publish relevant information used in the determination of whether or not a credit event has occurred.</xsd:documentation>
            </xsd:annotation>
          </xsd:element>
        </xsd:sequence>
      </xsd:extension>
    </xsd:complexContent>
  </xsd:complexType>
  <xsd:complexType name="CreditChangeEvent">
    <xsd:annotation>
      <xsd:documentation>A structure indicating that a trade has changed due to a credit event, including both shared (by single name, index and basket) and index specific components.</xsd:documentation>
    </xsd:annotation>
    <xsd:complexContent>
      <xsd:extension base="CreditChangeEventBase">
        <xsd:choice minOccurs="0">
          <xsd:element name="indexReferenceInformation" type="CreditEventIndexReferenceInformation">
            <xsd:annotation>
              <xsd:documentation>A type defining the Credit Default Swap Index impacted by the credit event.</xsd:documentation>
            </xsd:annotation>
          </xsd:element>
          <xsd:element name="excludedReferenceEntity" type="ReferenceInformation">
            <xsd:annotation>
              <xsd:documentation>The corporate or sovereign entity (and, optionally, associated obligations) in a basket impacted by the credit event.</xsd:documentation>
            </xsd:annotation>
          </xsd:element>
        </xsd:choice>
      </xsd:extension>
    </xsd:complexContent>
  </xsd:complexType>
  <xsd:complexType name="CreditLimitBase">
    <xsd:annotation>
      <xsd:documentation>A structure describing a basic credit limit.</xsd:documentation>
    </xsd:annotation>
    <xsd:sequence>
      <xsd:element name="limitId" type="LimitId" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">Specifies a unique identifier for a credit limit, as defined by a particular scheme.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:group ref="Product.model" />
      <xsd:element name="currency" type="Currency" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">Specifies the currency in which the credit limit is denominated.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="tenor" type="Period" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation>The maximum allowed tenor for a trade under this limit. When this structure is used as part of a suspendCredit message, this tenor imposes a temporary tenor limit on allowed trade types.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
    </xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="CreditLimit">
    <xsd:annotation>
      <xsd:documentation>A structure describing a credit limit with applicability constraints.</xsd:documentation>
    </xsd:annotation>
    <xsd:complexContent>
      <xsd:extension base="CreditLimitBase">
        <xsd:sequence>
          <xsd:element name="limitApplicable" type="LimitApplicable" minOccurs="0" maxOccurs="unbounded">
            <xsd:annotation>
              <xsd:documentation fpml-annotation:aiGenerated="true">Specifies the constraints and details of a credit limit that is applicable to a particular product or transaction.</xsd:documentation>
            </xsd:annotation>
          </xsd:element>
          <xsd:element name="expirationDate" type="xsd:dateTime" minOccurs="0">
            <xsd:annotation>
              <xsd:documentation fpml-annotation:aiGenerated="true">Specifies the date and time when the credit limit becomes invalid or expires.</xsd:documentation>
            </xsd:annotation>
          </xsd:element>
        </xsd:sequence>
      </xsd:extension>
    </xsd:complexContent>
  </xsd:complexType>
  <xsd:complexType name="CreditLimitInformation">
    <xsd:annotation>
      <xsd:documentation fpml-annotation:aiGenerated="true">A collection of credit limit details associated with a specific party. This structure facilitates the management and reporting of credit limits within financial transactions.</xsd:documentation>
    </xsd:annotation>
    <xsd:sequence>
      <xsd:element name="partyInformation" type="PartyTradeInformation" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">Details about the party associated with the credit limit, including identifiers, names, and related party information. It is an optional element and, when present, provides essential information about the party involved in the credit limit arrangement.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="limitModel" type="LimitModelEnum" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">Specifies the model used to determine credit limits within a credit limit agreement. Can take one of the following values: "Ping", "Plus1ToStop", "Plus1ToPing", "PushToPing", "PushToStop".</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="creditLimit" type="CreditLimit" minOccurs="0" maxOccurs="unbounded">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">A structure that defines a credit limit with specific applicability constraints. This structure allows for detailed specification of credit limits within financial transactions.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
    </xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="CreditLimitReference">
    <xsd:annotation>
      <xsd:documentation fpml-annotation:aiGenerated="true">This field is used to reference a specific credit limit approval. It contains two optional elements: approvingPartyReference, which is a reference to the party that approved the credit limit, and approvalId, which identifies the specific approval instance. This structure allows for detailed tracking of credit limit approvals within financial transactions.</xsd:documentation>
    </xsd:annotation>
    <xsd:sequence>
      <xsd:element name="approvingPartyReference" type="PartyReference" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">An optional reference to a party defined elsewhere in the document, indicating the entity responsible for approving the trade or financial instrument.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="approvalId" type="ApprovalId" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">An optional identifier for a specific approval, allowing it to be uniquely identified and tracked within the workflow.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
    </xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="CreditLimitUtilization">
    <xsd:annotation>
      <xsd:documentation fpml-annotation:aiGenerated="true">Represents the usage of a credit limit, detailing both executed and pending positions. It comprises two optional elements: executed and pending, both of which are of type CreditLimitUtilizationPosition. These elements provide a breakdown of the credit limit utilization, distinguishing between amounts that have been executed and those that are pending. This structure allows for a clear representation of how much of the credit limit has been utilized and how much is still pending execution.</xsd:documentation>
    </xsd:annotation>
    <xsd:sequence>
      <xsd:element name="executed" type="CreditLimitUtilizationPosition" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation>Credit limit utilization attributable to executed trades.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="pending" type="CreditLimitUtilizationPosition" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation>Credit limit utilization attributable to pending unexecuted orders.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
    </xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="CreditLimitUtilizationPosition">
    <xsd:annotation>
      <xsd:documentation fpml-annotation:aiGenerated="true">Specifies the utilization of a credit limit, detailing positions in terms of short, long, and global amounts.</xsd:documentation>
    </xsd:annotation>
    <xsd:choice>
      <xsd:sequence>
        <xsd:element name="short" type="NonNegativeDecimal" minOccurs="0">
          <xsd:annotation>
            <xsd:documentation>Credit limit utilization attributable to short positions.</xsd:documentation>
          </xsd:annotation>
        </xsd:element>
        <xsd:element name="long" type="NonNegativeDecimal" minOccurs="0">
          <xsd:annotation>
            <xsd:documentation>Credit limit utilization attributable to long positions.</xsd:documentation>
          </xsd:annotation>
        </xsd:element>
        <xsd:element name="global" type="NonNegativeDecimal" minOccurs="0">
          <xsd:annotation>
            <xsd:documentation>Global credit limit utilization amount, agnostic of long/short position direction.</xsd:documentation>
          </xsd:annotation>
        </xsd:element>
      </xsd:sequence>
    </xsd:choice>
  </xsd:complexType>
  <xsd:complexType name="EventId">
    <xsd:annotation>
      <xsd:documentation>A post-trade event reference identifier allocated by a party. FpML does not define the domain values associated with this element. Note that the domain values for this element are not strictly an enumerated list.</xsd:documentation>
    </xsd:annotation>
    <xsd:simpleContent>
      <xsd:extension base="NonEmptyScheme">
        <xsd:attribute name="eventIdScheme" type="NonEmptyURI" />
        <xsd:attribute name="id" type="xsd:ID" />
      </xsd:extension>
    </xsd:simpleContent>
  </xsd:complexType>
  <xsd:complexType name="IndexChange">
    <xsd:annotation>
      <xsd:documentation>A structure describing the effect of a change to an index.</xsd:documentation>
    </xsd:annotation>
    <xsd:complexContent>
      <xsd:extension base="ChangeEvent">
        <xsd:sequence>
          <xsd:element name="indexFactor" type="xsd:decimal" minOccurs="0">
            <xsd:annotation>
              <xsd:documentation fpml-annotation:aiGenerated="true">Represents the index version factor or percentage as an absolute decimal value between 0 and 1. This factor, when multiplied by the original notional amount, determines the adjusted notional amount following an index change. This structure allows for precise calculation of the impact of index adjustments on financial instruments.</xsd:documentation>
            </xsd:annotation>
          </xsd:element>
          <xsd:element name="factoredCalculationAmount" type="Money" minOccurs="0">
            <xsd:annotation>
              <xsd:documentation fpml-annotation:aiGenerated="true">Represents the monetary value obtained by applying the specified indexFactor to the original calculation amount. This adjusted amount reflects the impact of the index change on the financial instrument's value.</xsd:documentation>
            </xsd:annotation>
          </xsd:element>
        </xsd:sequence>
      </xsd:extension>
    </xsd:complexContent>
  </xsd:complexType>
  <xsd:complexType name="LimitApplicable">
    <xsd:annotation>
      <xsd:documentation fpml-annotation:aiGenerated="true">Specifies the details of a credit limit applied to a financial transaction.</xsd:documentation>
    </xsd:annotation>
    <xsd:sequence>
      <xsd:element name="limitType" type="LimitType" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation>Standard code to indicate which type of credit line is being referred to - i.e. IM, DV01, PV01, CS01, Notional, Clip Size, Notional, maximumOrderQuantity</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="clipSize" type="xsd:integer" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">Represents the maximum allowable amount or quantity for a specific limit type. The clipSize ensures that any transaction or position does not exceed the specified limit, thereby aiding in risk management and compliance with internal or regulatory requirements.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:choice minOccurs="0">
        <xsd:element name="amountUtilized" type="xsd:integer">
          <xsd:annotation>
            <xsd:documentation fpml-annotation:aiGenerated="true">Represents the amount of the credit limit that has been used. This element helps in monitoring and managing exposure by indicating how much of the available credit has been utilized.</xsd:documentation>
          </xsd:annotation>
        </xsd:element>
        <xsd:element name="utilization" type="CreditLimitUtilization">
          <xsd:annotation>
            <xsd:documentation>Credit limit utilization breakdown by executed trades and pending orders.</xsd:documentation>
          </xsd:annotation>
        </xsd:element>
      </xsd:choice>
      <xsd:element name="amountRemaining" type="xsd:integer" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">Represents the remaining amount of a credit limit that has not been utilized.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="currency" type="Currency" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">Specifies the currency in which the credit limit is denominated.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="velocity" type="Velocity" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">Specifies the frequency at which a credit limit is utilized or replenished.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
    </xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="LimitId">
    <xsd:annotation>
      <xsd:documentation fpml-annotation:aiGenerated="true">Uniquely identifies a credit limit within a financial institution's system. Its structure allows for the consistent and standardized representation of credit limit identifiers across different systems and platforms.</xsd:documentation>
    </xsd:annotation>
    <xsd:simpleContent>
      <xsd:extension base="NonEmptyScheme">
        <xsd:attribute name="creditLimitIdScheme" type="NonEmptyURI" />
      </xsd:extension>
    </xsd:simpleContent>
  </xsd:complexType>
  <xsd:complexType name="LimitType">
    <xsd:annotation>
      <xsd:documentation fpml-annotation:aiGenerated="true">Specifies the type of credit limit being referenced. It includes an attribute named creditLimitTypeScheme, which is a URI that points to the coding scheme used to define the credit limit type. This structure allows for the standardized representation of various credit limit types, such as IM (Initial Margin), DV01 (dollar value of 1 basis point), PV01 (price value of 1 basis point), CS01 (credit spread of 1 basis point), Notional, Clip Size, and maximum order quantity. By utilizing the LimitType complex type, financial institutions can effectively categorize and manage different types of credit limits within their systems.</xsd:documentation>
    </xsd:annotation>
    <xsd:simpleContent>
      <xsd:extension base="Scheme">
        <xsd:attribute name="creditLimitTypeScheme" type="NonEmptyURI" default="http://www.fpml.org/coding-scheme/credit-limit-type" />
      </xsd:extension>
    </xsd:simpleContent>
  </xsd:complexType>
  <xsd:complexType name="PackageHeader">
    <xsd:annotation>
      <xsd:documentation>Identifying information for a tradePackage (a bundle of trades).</xsd:documentation>
    </xsd:annotation>
    <xsd:sequence>
      <xsd:element name="packageIdentifier" type="IssuerTradeId" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">Uniquely identifies a trade package, which is a bundle of trades executed together. It consists of an issuer, representing the entity assigning the identifier, and a tradeId, which is the unique reference for the package within that issuer's system.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="orderIdentifier" type="OrderIdentifier" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">Represents a unique reference to an order associated with a trade package. It consists of an orderId, which uniquely identifies the order within a trading system or marketplace.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="packageType" type="PackageType" minOccurs="0" maxOccurs="unbounded">
        <xsd:annotation>
          <xsd:documentation>Classification of the package. FpML has defined a list of coding scheme values. Different organizations might have different naming schemes for the packages so the multiplicity of unbounded is meant to support synonyms but it does not mean that a trade has multiple package types.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="size" type="PositiveDecimal" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">The total quantity or notional amount of the trade package, expressed as a positive decimal value.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="originatingEvent" type="OriginatingEvent" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation>This may be used to describe why a package was created. This can be used to provide context for a newly created package that is not part of a post-trade event. For example, it can report that the package was created as a result of netting activity, or due to a transfer, an allocation process, etc.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="packageInformation" type="PackageInformation" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">Provides additional details about the trade package, including related parties, trade categories, execution timing, processing timestamps, allocation and clearing intentions, and execution venue type.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
    </xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="TerminatingEvent">
    <xsd:annotation>
      <xsd:documentation>A type that describes why a trade terminated.</xsd:documentation>
    </xsd:annotation>
    <xsd:simpleContent>
      <xsd:extension base="Scheme">
        <xsd:attribute name="terminatingEventScheme" type="NonEmptyURI" default="http://www.fpml.org/coding-scheme/terminating-event" />
      </xsd:extension>
    </xsd:simpleContent>
  </xsd:complexType>
  <xsd:complexType name="TradePackage">
    <xsd:annotation>
      <xsd:documentation>A bundle of trades collected together into a single unit for reporting.</xsd:documentation>
    </xsd:annotation>
    <xsd:sequence>
      <xsd:element name="packageHeader" type="PackageHeader" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">Provides essential metadata about a trade package. It includes identifiers, size, event information, and related details that describe the contents of the package. This structure helps in categorizing and organizing the trades into specific packages and provides information necessary for processing or referencing the package.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:choice minOccurs="0">
        <xsd:element name="trade" type="Trade" maxOccurs="unbounded">
          <xsd:annotation>
            <xsd:documentation fpml-annotation:aiGenerated="true">One or more trades, with each trade representing a specific transaction or agreement. It provides the details of the trade, which can be important for analysis or settlement. The use of maxOccurs="unbounded" indicates that a package can contain any number of trades, offering flexibility in how trade data is organized.</xsd:documentation>
          </xsd:annotation>
        </xsd:element>
        <xsd:group ref="TradeReferenceInformation.model" maxOccurs="unbounded" />
        <xsd:element name="tradeIdentifier" type="TradeIdentifier" maxOccurs="unbounded">
          <xsd:annotation>
            <xsd:documentation fpml-annotation:aiGenerated="true">Uniquely identifies one or more trades within the package. It ensures that each trade can be traced and associated with its corresponding transaction or agreement.</xsd:documentation>
          </xsd:annotation>
        </xsd:element>
      </xsd:choice>
      <xsd:element name="allocations" type="Allocations" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation>"Short-form" representation of allocations in which the key block economics are stated once within the trade structure, and the allocation data is contained in this allocations structure. This will normally be expressed in percentage terms and used prior to execution to authorize credit.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="approvals" type="Approvals" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation>A container for approval states in the workflow.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
    </xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="TradeReferenceInformation">
    <xsd:annotation>
      <xsd:documentation>Defines a type that allows trade identifiers and/or trade information to be represented for a trade.</xsd:documentation>
    </xsd:annotation>
    <xsd:sequence>
      <xsd:choice minOccurs="0">
        <xsd:element name="originatingEvent" type="OriginatingEvent">
          <xsd:annotation>
            <xsd:documentation>This may be used to describe why a trade was created. This can be used to provide context for a newly created trade that is not part of a post-trade event. For example, it can report that the trade was created as a result of netting activity, or due to a transfer, an allocation process, etc. Omitting this implies that the trade record was created as a result of a negotiated new trade.</xsd:documentation>
          </xsd:annotation>
        </xsd:element>
        <xsd:element name="terminatingEvent" type="TerminatingEvent">
          <xsd:annotation>
            <xsd:documentation>This may be used to describe why a trade was terminated.</xsd:documentation>
          </xsd:annotation>
        </xsd:element>
      </xsd:choice>
      <xsd:element name="partyTradeIdentifier" type="PartyTradeIdentifier" minOccurs="0" maxOccurs="unbounded">
        <xsd:annotation>
          <xsd:documentation>This allows the acknowledging party to supply additional trade identifiers for a trade underlying a request relating to a business event.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="partyTradeInformation" type="PartyTradeInformation" minOccurs="0" maxOccurs="unbounded">
        <xsd:annotation>
          <xsd:documentation>This allows the acknowledging party to supply additional trade information about a trade underlying a request relating to a business event.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="productType" type="ProductType" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">Specifies the classification of the financial product associated with a trade. It provides a standardized way to categorize trades based on predefined taxonomies.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="productId" type="ProductId" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">Uniquely identifies the financial product associated with a trade. It provides a standardized identifier that can be used across systems for tracking and reference.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
    </xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="Velocity">
    <xsd:annotation>
      <xsd:documentation fpml-annotation:aiGenerated="true">The speed at which an underlying reference, such as a price or rate, changes over a defined time period. It is commonly used in financial contracts and derivative calculations where rate-of-change metrics are relevant.</xsd:documentation>
    </xsd:annotation>
    <xsd:sequence>
      <xsd:element name="periodMultiplier" type="xsd:integer" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">Specifies the number of time units used to measure velocity. It is an integer value that, when combined with the period element, defines the total duration over which velocity is calculated.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="period" type="PeriodTimeEnum" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">Defines the time unit over which velocity is calculated. It is an enumerated value that can represent standard financial time periods ("D" for days, "W" for weeks, "M" for months, "Y" for years) or finer time intervals ("Hour," "Minute," "Second") for high-frequency measurements.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
    </xsd:sequence>
  </xsd:complexType>
  <xsd:element name="additionalEvent" type="AdditionalEvent" abstract="true">
    <xsd:annotation>
      <xsd:documentation>The additionalEvent element is an extension/substitution point to customize FpML and add additional events.</xsd:documentation>
    </xsd:annotation>
  </xsd:element>
  <xsd:element name="basketChange" type="BasketChangeEvent" substitutionGroup="changeEvent">
    <xsd:annotation>
      <xsd:documentation>Describes a change due to change in composition of basket underlyer</xsd:documentation>
    </xsd:annotation>
  </xsd:element>
  <xsd:element name="changeEvent" type="ChangeEvent">
    <xsd:annotation>
      <xsd:documentation>Abstract substitutable place holder for specific change details.</xsd:documentation>
    </xsd:annotation>
  </xsd:element>
  <xsd:element name="creditChangeEvent" type="CreditChangeEvent" substitutionGroup="changeEvent">
    <xsd:annotation>
      <xsd:documentation>Describes a change due to a credit event.</xsd:documentation>
    </xsd:annotation>
  </xsd:element>
  <xsd:element name="corporateAction" type="CorporateActionEvent" substitutionGroup="changeEvent">
    <xsd:annotation>
      <xsd:documentation>Describes a change due to a corporate action</xsd:documentation>
    </xsd:annotation>
  </xsd:element>
  <xsd:element name="indexChange" type="IndexChange" substitutionGroup="changeEvent">
    <xsd:annotation>
      <xsd:documentation>Describes a change due to an index component being adjusted.</xsd:documentation>
    </xsd:annotation>
  </xsd:element>
  <xsd:group name="TradingEvents.model">
    <xsd:annotation>
      <xsd:documentation>Information about a trading event that represent a new trading activity (on a newly-created trade), or in some cases the a representation of the trade's current state. Also allows the "additionEvent" extension point.</xsd:documentation>
    </xsd:annotation>
    <xsd:choice>
      <xsd:group ref="TradingEventsBase.model" />
      <xsd:element ref="additionalEvent">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">An abstract extension point for capturing trading events not explicitly defined within standard trading event models. It serves as a flexible framework for incorporating custom or emerging events related to trade lifecycle management, allowing for future extensions while maintaining consistency with the existing event structure.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
    </xsd:choice>
  </xsd:group>
  <xsd:group name="TradingEventsBase.model">
    <xsd:annotation>
      <xsd:documentation>Information about a trading event that represents a new trading activity (on a newly-created trade or package of trades), or in some cases the a representation of the trade's current state..</xsd:documentation>
    </xsd:annotation>
    <xsd:choice>
      <xsd:element name="tradePackage" type="TradePackage">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">A structured collection of related trades grouped under a common package. It includes a package header for metadata, multiple trade instances or references, and optional elements for allocations and approvals. This element facilitates efficient management of complex trading strategies, block trades, or multi-leg transactions by encapsulating all relevant trade details within a single package.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:sequence>
        <xsd:element name="trade" type="Trade">
          <xsd:annotation>
            <xsd:documentation fpml-annotation:aiGenerated="true">The details of a financial transaction between parties. It encapsulates key information such as product terms, counterparties, pricing, and execution details. This element serves as the foundational unit of financial contracts, supporting various trade events and lifecycle actions within the FpML framework.</xsd:documentation>
          </xsd:annotation>
        </xsd:element>
      </xsd:sequence>
    </xsd:choice>
  </xsd:group>
  <xsd:group name="EventValuation.model">
    <xsd:annotation>
      <xsd:documentation>A model group holding valuation information for an event.</xsd:documentation>
    </xsd:annotation>
    <xsd:sequence>
      <xsd:element name="quote" type="BasicQuotation" minOccurs="0" maxOccurs="unbounded">
        <xsd:annotation>
          <xsd:documentation>Pricing information for the trade.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
    </xsd:sequence>
  </xsd:group>
  <xsd:group name="TradeReferenceInformation.model">
    <xsd:annotation>
      <xsd:documentation>Defines a model group that allows information about a trade to be represented.</xsd:documentation>
    </xsd:annotation>
    <xsd:sequence>
      <xsd:element name="tradeReferenceInformation" type="TradeReferenceInformation" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation>Information about a trade.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
    </xsd:sequence>
  </xsd:group>
  <xsd:complexType name="CreditEventType">
    <xsd:annotation>
      <xsd:documentation>A type that describes which credit event is taking place, e.g. Bankruptcy, FailureToPay, etc.</xsd:documentation>
    </xsd:annotation>
    <xsd:simpleContent>
      <xsd:extension base="Scheme">
        <xsd:attribute name="creditEventTypeScheme" type="NonEmptyURI" default="http://www.fpml.org/coding-scheme/credit-event-type" />
      </xsd:extension>
    </xsd:simpleContent>
  </xsd:complexType>
  <xsd:simpleType name="CashOrPhysicalSettlementEnum">
    <xsd:restriction base="xsd:token">
