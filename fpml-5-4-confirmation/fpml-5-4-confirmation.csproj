<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <RootNamespace>fpml_5_4_confirmation</RootNamespace>
    <AssemblyName>fpml-5-4-confirmation</AssemblyName>
    <PackageId>FpmlToolKit.Fpml54.Confirmation</PackageId>
    <Description>Strongly typed LINQ to XSD classes for the FpML 5.4 confirmation view.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="XObjectsCore" Version="3.4.23" />
  </ItemGroup>

  <ItemGroup>
    <LinqToXsdSchema Include="xsd\fpml-main-5-4.xsd" />
    <LinqToXsdConfiguration Include="xsd\namespaceconfig.xml" />
    <None Include="xsd\**" Pack="true" PackagePath="xsd\" />
  </ItemGroup>

</Project>
