<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <RootNamespace>fpml_4_4</RootNamespace>
    <AssemblyName>fpml-4-4</AssemblyName>
    <PackageId>FpmlToolKit.Fpml44</PackageId>
    <Description>Strongly typed LINQ to XSD classes for FpML 4.4.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="XObjectsCore" Version="3.4.23" />
  </ItemGroup>

  <ItemGroup>
    <LinqToXsdSchema Include="xsd\fpml-main-4-4.xsd" />
    <LinqToXsdConfiguration Include="xsd\namespaceconfig.xml" />
    <None Include="xsd\**" Pack="true" PackagePath="xsd\" />
  </ItemGroup>

</Project>
