<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <RootNamespace>fpml_5_11_legal</RootNamespace>
    <AssemblyName>fpml-5-11-legal</AssemblyName>
    <PackageId>FpmlToolKit.Fpml511.Legal</PackageId>
    <Description>Strongly typed LINQ to XSD classes for the FpML 5.11 legal view.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="XObjectsCore" Version="3.4.23" />
  </ItemGroup>

  <ItemGroup>
    <LinqToXsdSchema Include="xsd\fpml-main-5-11.xsd" />
    <LinqToXsdConfiguration Include="xsd\namespaceconfig.xml" />
    <None Include="xsd\**" Pack="true" PackagePath="xsd\" />
  </ItemGroup>

</Project>
