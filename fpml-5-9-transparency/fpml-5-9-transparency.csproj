<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <RootNamespace>fpml_5_9_transparency</RootNamespace>
    <AssemblyName>fpml-5-9-transparency</AssemblyName>
    <PackageId>FpmlToolKit.Fpml59.Transparency</PackageId>
    <Description>Strongly typed LINQ to XSD classes for the FpML 5.9 transparency view.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="XObjectsCore" Version="3.4.23" />
  </ItemGroup>

  <ItemGroup>
    <LinqToXsdSchema Include="xsd\fpml-main-5-9.xsd" />
    <LinqToXsdConfiguration Include="xsd\namespaceconfig.xml" />
    <None Include="xsd\**" Pack="true" PackagePath="xsd\" />
  </ItemGroup>

</Project>
