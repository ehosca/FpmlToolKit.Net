<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <RootNamespace>fpml_5_13_reporting</RootNamespace>
    <AssemblyName>fpml-5-13-reporting</AssemblyName>
    <PackageId>FpmlToolKit.Fpml513.Reporting</PackageId>
    <Description>Strongly typed LINQ to XSD classes for the FpML 5.13 reporting view.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="XObjectsCore" Version="3.4.23" />
  </ItemGroup>

  <ItemGroup>
    <LinqToXsdSchema Include="xsd\fpml-main-5-13.xsd" />
    <LinqToXsdConfiguration Include="xsd\namespaceconfig.xml" />
    <None Include="xsd\**" Pack="true" PackagePath="xsd\" />
  </ItemGroup>

</Project>
