      </xsd:extension>
    </xsd:complexContent>
  </xsd:complexType>
  <xsd:complexType name="ExposurePartyType">
    <xsd:annotation>
      <xsd:documentation>A code that describes the high level category of the counterparty for exposure purposes. For example, G15, NonG15.</xsd:documentation>
    </xsd:annotation>
