  <xsd:element name="exposureReport" type="ExposureReport">
    <xsd:annotation>
      <xsd:documentation fpml-annotation:aiGenerated="true">A message that allows a firm to send a report listing aggregate exposure to various counterparty and market risk categories. This report is provided from the perspective of the "on-behalf-of" party.</xsd:documentation>
