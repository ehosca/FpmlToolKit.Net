        </xsd:annotation>
      </xsd:element>
      <xsd:element name="exposure" type="ReportedExposure" minOccurs="0" maxOccurs="unbounded">
        <xsd:annotation>
          <xsd:documentation>Sub-divisions of this total expsoure.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
    </xsd:sequence>
  </xsd:complexType>
