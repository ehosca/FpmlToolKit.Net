      <xsd:documentation fpml-annotation:aiGenerated="true">This message notifies another system about detected exceptions within an exposure report.</xsd:documentation>
    </xsd:annotation>
  </xsd:element>
  <xsd:element name="collateralAllocationReport" type="CollateralAllocationReport">
