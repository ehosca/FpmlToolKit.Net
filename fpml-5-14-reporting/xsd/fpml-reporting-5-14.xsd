  <xsd:element name="resetReportException" type="Exception">
    <xsd:annotation>
      <xsd:documentation fpml-annotation:aiGenerated="true">This message notifies another system of an exception detected during the processing of a reset report.</xsd:documentation>
    </xsd:annotation>
  </xsd:element>
  <xsd:element name="partyReport" type="PartyReport">
    <xsd:annotation>
      <xsd:documentation fpml-annotation:aiGenerated="true">This message sends a report detailing party information and their relationships. This structure enables the comprehensive reporting of party-related data within financial messages.</xsd:documentation>
    </xsd:annotation>
  </xsd:element>
  <xsd:element name="partyReportAcknowledgement" type="Acknowledgement">
    <xsd:annotation>
      <xsd:documentation fpml-annotation:aiGenerated="true">A message confirming the receipt and processing of a partyReport. It indicates that the receiving party has successfully received and understood the party information and relationships detailed in the original report.</xsd:documentation>
    </xsd:annotation>
  </xsd:element>
  <xsd:element name="partyReportException" type="Exception">
    <xsd:annotation>
      <xsd:documentation fpml-annotation:aiGenerated="true">This message notifies another system of an exception detected during the processing of a party report.</xsd:documentation>
    </xsd:annotation>
