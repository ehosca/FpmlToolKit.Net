          <xsd:element name="reportContents" type="ReportContents" minOccurs="0">
            <xsd:annotation>
              <xsd:documentation>The specific characteristics included in the report.</xsd:documentation>
            </xsd:annotation>
          </xsd:element>
          <xsd:element name="fromDateTime" type="xsd:dateTime" minOccurs="0">
            <xsd:annotation>
              <xsd:documentation>The starting point for reporting expirations/maturities in this report.</xsd:documentation>
            </xsd:annotation>
          </xsd:element>
          <xsd:element name="toDateTime" type="xsd:dateTime" minOccurs="0">
            <xsd:annotation>
              <xsd:documentation>The ending point for reporting expirations/maturities in this report.</xsd:documentation>
            </xsd:annotation>
          </xsd:element>
          <xsd:group ref="MaturityAndExpiryEvents.model" maxOccurs="unbounded" />
          <xsd:group ref="PartiesAndAccounts.model" />
        </xsd:sequence>
      </xsd:extension>
    </xsd:complexContent>
  </xsd:complexType>
  <xsd:group name="ExposureCategory.model">
    <xsd:annotation>
      <xsd:documentation>A group a specific set of counterparty and market risk factors for which an exposure record is provided.</xsd:documentation>
    </xsd:annotation>
    <xsd:sequence>
      <xsd:group ref="PartyExposureCategory.model" />
      <xsd:group ref="ProductExposureCategory.model" />
    </xsd:sequence>
  </xsd:group>
  <xsd:group name="PartyExposureCategory.model">
    <xsd:annotation>
      <xsd:documentation>A group a specific set of counterparty risk factors for which an exposure record is provided.</xsd:documentation>
    </xsd:annotation>
    <xsd:sequence>
      <xsd:element name="region" type="Region" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">A code identifying a grouping of countries to which a particular entity or asset belongs. This classification aids in categorizing financial instruments or counterparties based on their geographical regions.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="country" type="CountryCode" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">The ISO 3166 code for a country or area of special sovereignty.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="counterpartyType" type="ExposurePartyType" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">The high-level category of a counterparty for exposure purposes.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="creditRating" type="CreditRating" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">The credit rating assigned to a party. It includes an attribute named creditRatingScheme, which has a default value of "http://www.fpml.org/coding-scheme/external/moodys". The creditRating element is optional and can occur multiple times within the PartyExposureCategory.model group.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="partyReference" type="PartyReference" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">Serves as a pointer to a party identifier defined elsewhere in the document. The partyReference element is optional and can occur multiple times within the PartyExposureCategory.model group.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="accountReference" type="AccountReference" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">Serves as a reference to an account. This structure allows for the identification of the specific account associated with the exposure category, facilitating the tracking and management of financial exposures related to particular accounts.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="relatedParty" type="RelatedParty" minOccurs="0" maxOccurs="unbounded">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">Identifies one or more parties that perform a specific role within a transaction. Each relatedParty element contains references to the party and account, along with optional details such as the role and type of the related party.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="cleared" type="xsd:boolean" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">A boolean value that indicates whether a trade or exposure has been cleared through a central counterparty (CCP). This element is used to distinguish between cleared and non-cleared trades, which is important for regulatory reporting and risk management purposes.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="industryClassification" type="IndustryClassification" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">The industry sector classification of a party, such as Mining, Education, or Construction. It includes an attribute named industryClassificationScheme, indicating that the classification follows the regulatory corporate sector coding scheme defined by FpML.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="category" type="TradeCategory" minOccurs="0" maxOccurs="unbounded">
        <xsd:annotation>
          <xsd:documentation>Used to categorize trades into user-defined categories, such as house trades vs. customer trades.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
    </xsd:sequence>
  </xsd:group>
  <xsd:group name="ProductExposureCategory.model">
    <xsd:annotation>
      <xsd:documentation>A group a specific set of market risk factors for which an exposure record is provided.</xsd:documentation>
    </xsd:annotation>
    <xsd:sequence>
      <xsd:element name="assetClass" type="AssetClass" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">An indicator of the classification of the risk class of a trade. It includes an attribute named assetClassScheme, indicating that the classification follows the asset class coding scheme defined by FpML. This element is used to categorize financial products into different asset classes, such as equities, fixed income, commodities, etc., to facilitate risk assessment and reporting.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="productType" type="ProductType" minOccurs="0" maxOccurs="unbounded">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">Classifies the type of financial product. The productType can occur multiple times within the ProductExposureCategory.model group, allowing for the classification of multiple product types within a single exposure record.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="productId" type="ProductId" minOccurs="0" maxOccurs="unbounded">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">A reference identifier for a financial product, encapsulating its key economic characteristics. This identifier is a string that uniquely distinguishes the product within a given context. It is used to hold identifiers such as the "UPI" (Universal Product Identifier) required by certain regulatory reporting rules.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="currency" type="Currency" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">The currency associated with a financial instrument or transaction. The currency code adheres to the ISO 4217 standard, ensuring consistency and clarity in financial reporting and transactions.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="underlyingAsset" type="ExposureUnderlyingAsset" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">A reference to an asset that underlies a financial transaction or exposure. This structure allows for the identification and description of the asset associated with a particular exposure.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="relatedAsset" type="ExposureUnderlyingAsset" minOccurs="0" maxOccurs="unbounded">
        <xsd:annotation>
          <xsd:documentation>This can be used to report assets that are related to this exposure, such as the asset on the other side of a basis trade.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="exposureType" type="ExposureType" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">Specifies the nature of risk or exposure associated with a financial instrument. This structure allows for standardized classification of exposure types, facilitating consistent reporting and analysis across different financial products.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="indexTenor" type="Period" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">The duration associated with an index, such as the length of time until the index's maturity or reset.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="sector" type="Sector" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">The industry sector associated with a financial product or instrument. This structure allows for the classification of products or instruments according to specific industry sectors, facilitating detailed exposure reporting.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="sectorType" type="SectorType" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">The type of industry sector associated with a financial product or instrument. This structure allows for detailed classification of products or instruments according to specific industry sector types, facilitating comprehensive exposure reporting.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="seniority" type="CreditSeniority" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation>The repayment precedence of a debt instrument.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="restructuring" type="Restructuring" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation>A credit event. A restructuring is an event that materially impacts the reference entity's obligations, such as an interest rate reduction, principal reduction, deferral of interest or principal, change in priority ranking, or change in currency or composition of payment. ISDA 2003 Term: Restructuring.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="couponRate" type="xsd:decimal" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation>Specifies the coupon rate (expressed in percentage) of a fixed income security or convertible bond.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:choice minOccurs="0">
        <xsd:element name="futuresEquivalentMonth" type="YearAndMonth">
          <xsd:annotation>
            <xsd:documentation fpml-annotation:aiGenerated="true">The expiration month of a futures contract associated with a particular exposure. Formatted as 'yyyy-mm', it indicates the year and month when the contract expires.</xsd:documentation>
          </xsd:annotation>
        </xsd:element>
        <xsd:element name="priceReferenceMonth" type="YearAndMonth">
          <xsd:annotation>
            <xsd:documentation fpml-annotation:aiGenerated="true">The month and year associated with the reference price of a financial instrument. Formatted as 'yyyy-mm', it indicates the specific time period pertinent to the instrument's pricing.</xsd:documentation>
          </xsd:annotation>
        </xsd:element>
      </xsd:choice>
      <xsd:element name="optionType" type="PutCallEnum" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">Specifies the type of an option contract, indicating whether it is a "Put" or a "Call" option.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
      <xsd:element name="expirationDate" type="xsd:date" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation fpml-annotation:aiGenerated="true">Specifies the date when a financial contract, such as an option or a futures contract, expires. This date is crucial for determining the contract's maturity and the timing of any associated settlements or exercises. The expirationDate is formatted according to the ISO 8601 standard (YYYY-MM-DD), which allows for consistent interpretation and processing of dates across different systems and platforms.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
    </xsd:sequence>
  </xsd:group>
  <xsd:group name="ReportableEvents.model">
    <xsd:choice>
      <xsd:group ref="Events.model" maxOccurs="unbounded" />
      <xsd:element name="clearingStatusItem" type="ClearingStatusItem" minOccurs="0">
        <xsd:annotation>
          <xsd:documentation>Describes the status of the clearing process relating to the identified trade.</xsd:documentation>
        </xsd:annotation>
      </xsd:element>
    </xsd:choice>
  </xsd:group>
  <xsd:annotation>
    <xsd:documentation>Reporting messages.</xsd:documentation>
  </xsd:annotation>
  <xsd:element name="requestPositionReport" type="RequestPositionReport">
    <xsd:annotation>
      <xsd:documentation fpml-annotation:aiGenerated="true">Requests a position report from a counterparty or a system. It extends the CorrectableRequestMessage complex type and includes several optional elements.</xsd:documentation>
    </xsd:annotation>
  </xsd:element>
  <xsd:element name="positionReport" type="PositionReport">
    <xsd:annotation>
      <xsd:documentation fpml-annotation:aiGenerated="true">Represents a message that allows one party to send a report consisting of positions. It is defined as a complex type that extends NotificationMessage and includes a sequence of elements such as asOfDate, dataSetName, reportContents, quotationCharacteristics, submissionsComplete, and multiple position elements. The position elements are of type ReportedPosition and are used to detail the individual positions being reported. This structure enables the transmission of comprehensive position data between parties.</xsd:documentation>
    </xsd:annotation>
  </xsd:element>
  <xsd:element name="positionReportAcknowledgement" type="Acknowledgement">
    <xsd:annotation>
      <xsd:documentation fpml-annotation:aiGenerated="true">A response message that acknowledges the receipt and processing status of a previously sent positionReport. This structure allows the sender to confirm that the original position report has been successfully received and processed by the recipient.</xsd:documentation>
    </xsd:annotation>
  </xsd:element>
  <xsd:element name="positionReportException" type="Exception">
    <xsd:annotation>
      <xsd:documentation fpml-annotation:aiGenerated="true">This message notifies a counterparty or system of an exception detected during the processing of a position report.</xsd:documentation>
    </xsd:annotation>
  </xsd:element>
  <xsd:element name="positionActivityReport" type="PositionActivityReport">
    <xsd:annotation>
      <xsd:documentation fpml-annotation:aiGenerated="true">A message that allows a party to send a report containing a series of updates to positions.</xsd:documentation>
    </xsd:annotation>
  </xsd:element>
  <xsd:element name="positionActivityReportAcknowledgement" type="Acknowledgement">
    <xsd:annotation>
      <xsd:documentation fpml-annotation:aiGenerated="true">A message that acknowledges the receipt of a positionActivityReport message. Its structure allows the acknowledging party to reference the original message and provide relevant party and account information.</xsd:documentation>
    </xsd:annotation>
  </xsd:element>
  <xsd:element name="positionActivityReportException" type="Exception">
    <xsd:annotation>
      <xsd:documentation fpml-annotation:aiGenerated="true">This message notifyies a counterparty or system of an exception detected during the processing of a position activity report.</xsd:documentation>
    </xsd:annotation>
  </xsd:element>
  <xsd:element name="terminatingEventsReport" type="TerminatingEventsReport">
    <xsd:annotation>
      <xsd:documentation fpml-annotation:aiGenerated="true">This message reports a series of maturity and option expiry events for trades. It can convey information about upcoming expirations or maturities, as well as events that have already occurred. Its design ensures comprehensive reporting of terminating events within financial products.</xsd:documentation>
    </xsd:annotation>
  </xsd:element>
  <xsd:element name="terminatingEventsReportAcknowledgement" type="Acknowledgement">
    <xsd:annotation>
      <xsd:documentation fpml-annotation:aiGenerated="true">An acknowledgment message sent in response to a terminatingEventsReport. It confirms receipt and processing of the report, ensuring both parties are aligned on the status of the termination events communicated.</xsd:documentation>
    </xsd:annotation>
  </xsd:element>
  <xsd:element name="terminatingEventsReportException" type="Exception">
    <xsd:annotation>
      <xsd:documentation fpml-annotation:aiGenerated="true">This message notifies a counterparty or system of an exception detected during the processing of a terminating events report.</xsd:documentation>
    </xsd:annotation>
  </xsd:element>
  <xsd:element name="eventActivityReport" type="EventActivityReport">
    <xsd:annotation>
      <xsd:documentation fpml-annotation:aiGenerated="true">A message designed to enable a party to send a report detailing a series of trading events that may affect positions.</xsd:documentation>
    </xsd:annotation>
  </xsd:element>
  <xsd:element name="eventActivityReportAcknowledgement" type="Acknowledgement">
    <xsd:annotation>
      <xsd:documentation fpml-annotation:aiGenerated="true">A message that is sent to confirm the receipt of an eventActivityReport. This acknowledgment ensures that the reporting party is aware that their event activity report has been received and processed by the recipient system.</xsd:documentation>
    </xsd:annotation>
  </xsd:element>
  <xsd:element name="eventActivityReportException" type="Exception">
    <xsd:annotation>
      <xsd:documentation fpml-annotation:aiGenerated="true">This message notifies a system of an exception detected during the processing of an event activity report.</xsd:documentation>
    </xsd:annotation>
  </xsd:element>
  <xsd:element name="resetReport" type="ResetReport">
    <xsd:annotation>
      <xsd:documentation fpml-annotation:aiGenerated="true">A message that allows one party to report an observed or set index and the positions affected by this index. This structure enables efficient communication of index resets and their impact on relevant positions between parties.</xsd:documentation>
