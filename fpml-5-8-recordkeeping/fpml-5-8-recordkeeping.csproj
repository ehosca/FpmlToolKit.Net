<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <RootNamespace>fpml_5_8_recordkeeping</RootNamespace>
    <AssemblyName>fpml-5-8-recordkeeping</AssemblyName>
    <PackageId>FpmlToolKit.Fpml58.Recordkeeping</PackageId>
    <Description>Strongly typed LINQ to XSD classes for the FpML 5.8 recordkeeping view.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="XObjectsCore" Version="3.4.23" />
  </ItemGroup>

  <ItemGroup>
    <LinqToXsdSchema Include="xsd\fpml-main-5-8.xsd" />
    <LinqToXsdConfiguration Include="xsd\namespaceconfig.xml" />
    <None Include="xsd\**" Pack="true" PackagePath="xsd\" />
  </ItemGroup>

</Project>
