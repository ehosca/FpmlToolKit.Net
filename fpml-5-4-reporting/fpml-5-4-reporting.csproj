<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <RootNamespace>fpml_5_4_reporting</RootNamespace>
    <AssemblyName>fpml-5-4-reporting</AssemblyName>
    <Description>Strongly typed LINQ to XSD classes for the FpML 5.4 reporting view.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="XObjectsCore" Version="3.4.23" />
  </ItemGroup>

  <ItemGroup>
    <LinqToXsdSchema Include="xsd\fpml-main-5-4.xsd" />
    <LinqToXsdConfiguration Include="xsd\namespaceconfig.xml" />
  </ItemGroup>

</Project>
